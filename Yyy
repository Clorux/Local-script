end

local function sincStable(u)
    if abs(u) < 1e-4 then
        local u2 = u * u
        return 1.0 - u2 * (0.16666666666666666 - u2 * 0.008333333333333333)
    end
    return sin(u) / u
end

local function updateYawRateAlphaBeta(vx, vz, psiPrev, omegaPrev, dt, alpha, beta)
    local vhSq = vx * vx + vz * vz
    if vhSq < 1e-4 or dt <= 1e-6 then
        return psiPrev, omegaPrev * 0.95
    end
    local psiMeas = atan2(vz, vx)
    local psiPred = psiPrev + omegaPrev * dt
    local res = psiMeas - psiPred
    while res > 3.141592653589793 do
        res = res - 6.283185307179586
    end
    while res < -3.141592653589793 do
        res = res + 6.283185307179586
    end
    local psiNew = psiPred + alpha * res
    local omegaNew = omegaPrev + (beta / dt) * res
    return psiNew, omegaNew
end

local function isolateConvexMinimum(c4, c3, c2, c1, a, fa, d1a, b, fb, d1b)
    local m = (a * d1b - b * d1a) / (d1b - d1a)
    m = clamp(m, a + 1e-7 * (b - a), b - 1e-7 * (b - a))

    for _ = 1, 2 do
        local b3 = c4 * m + c3
        local d2 = c4 * m + b3
        local h2 = c4 * m + d2
        local b2 = b3 * m + c2
        local d1 = d2 * m + b2
        h2 = h2 * m + d1
        local b1 = b2 * m + c1
        d1 = d1 * m + b1
        local fm = b1 * m + 1.0

        if fm <= 0.0 and d1 <= 0.0 then
            return m, fm
        end

        if d1 < 0.0 then
            a, fa, d1a = m, fm, d1
        else
            b, fb, d1b = m, fm, d1
        end

        local g1 = 2.0 * h2
        local gh2 = 12.0 * c4 * m + 3.0 * c3
        local denom = g1 * g1 - d1 * gh2
        local mNext
        if denom > 1e-14 then
            mNext = m - (d1 * g1) / denom
        else
            mNext = (a * d1b - b * d1a) / (d1b - d1a)
        end

        if mNext <= a or mNext >= b then
            mNext = 0.5 * (a + b)
        end
        m = mNext
    end

    local fm = (((c4 * m + c3) * m + c2) * m + c1) * m + 1.0
    return m, fm
end

local function refineQuarticBracketHalleyITP(c4, c3, c2, c1, sL, fL, sU, fU, sWarm)
    if abs(fU) <= 1e-12 then
        local d1U = ((4.0 * c4 * sU + 3.0 * c3) * sU + 2.0 * c2) * sU + c1
        return sU, d1U
    end

    local s
    if sWarm > sL and sWarm < sU then
        local fWarm = (((c4 * sWarm + c3) * sWarm + c2) * sWarm + c1) * sWarm + 1.0
        if fWarm > 0.0 then
            sL, fL = sWarm, fWarm
        else
            sU, fU = sWarm, fWarm
        end
        s = sWarm
    else
        s = (sL * fU - sU * fL) / (fU - fL)
        s = clamp(s, sL + 0.05 * (sU - sL), sU - 0.05 * (sU - sL))
    end

    local fPrev = fL - fU
    local d1Final = -1.0

    for _ = 1, 4 do
        local b3 = c4 * s + c3
        local d2 = c4 * s + b3
        local h2 = c4 * s + d2

        local b2 = b3 * s + c2
        local d1 = d2 * s + b2
        h2 = h2 * s + d1

        local b1 = b2 * s + c1
        d1 = d1 * s + b1
        local f = b1 * s + 1.0
        d1Final = d1

        local absF = abs(f)
        if absF <= 1e-12 or (sU - sL) <= 1e-11 then
            return s, d1
        end

        if f > 0.0 then
            sL, fL = s, f
        else
            sU, fU = s, f
        end

        local d1Sq = d1 * d1
        local fh2 = f * h2
        local delta
        if d1Sq > 2.0 * abs(fh2) and d1Sq > 1e-14 then
            delta = -(f * d1) / (d1Sq - fh2)
        else
            local disc = max(0.0, d1Sq - 4.0 * fh2)
            local denom = d1 - sqrt(disc)
            if abs(denom) > 1e-14 then
                delta = (-2.0 * f) / denom
            else
                delta = -f / (d1 - 1e-7)
            end
        end

        local sTrial = s + delta
        if sTrial > sL and sTrial < sU and absF < 0.55 * fPrev then
            s = sTrial
        else
            local sSec = (sL * fU - sU * fL) / (fU - fL)
            local sMid = 0.5 * (sL + sU)
            s = clamp(0.5 * (sSec + sMid), sL + 1e-7 * (sU - sL), sU - 1e-7 * (sU - sL))
        end
        fPrev = absF
    end

    return s, d1Final
end

local function solveCTRVGeodesic(dx, dy, dz, vh, th0, omega, lx, ly, lz, qx, qy, qz, vProj, tSeed, tMax)
    local vProjSq = vProj * vProj
    local distSq = dx * dx + dy * dy + dz * dz
    local tol = 1e-10 * (1.0 + distSq)

    local function evalArcJet(t)
        local u = 0.5 * omega * t
        local snc = sincStable(u)
        local thm = th0 + u
        local arc = vh * t * snc
        local rx = dx + arc * cos(thm) + (lx + 0.5 * qx * t) * t
        local ry = dy + (ly + 0.5 * qy * t) * t
        local rz = dz + arc * sin(thm) + (lz + 0.5 * qz * t) * t

        local th = th0 + omega * t
        local cth = cos(th)
        local sth = sin(th)
        local vx = vh * cth + lx + qx * t
        local vy = ly + qy * t
        local vz = vh * sth + lz + qz * t

        local ax = -vh * omega * sth + qx
        local ay = qy
        local az = vh * omega * cth + qz

        local F = (rx * rx + ry * ry + rz * rz) - vProjSq * t * t
        local D1 = 2.0 * (rx * vx + ry * vy + rz * vz - vProjSq * t)
        local H2 = (vx * vx + vy * vy + vz * vz) + (rx * ax + ry * ay + rz * az) - vProjSq
        return F, D1, H2
    end

    local tL = 0.0
    local fL = distSq
    local tU = tSeed
    local f0, d1_0 = evalArcJet(tSeed)
    local fU = f0
    local hasBracket = false

    if f0 <= 0.0 then
        hasBracket = true
    else
        tL, fL = tSeed, f0
        tU = tSeed
        for _ = 1, 6 do
            tU = min(tMax, tU * 1.3 + 0.02)
            local fTest = evalArcJet(tU)
            if fTest <= 0.0 then
                fU = fTest
                hasBracket = true
                break
            end
            if tU >= tMax then
                break
            end
        end
    end

    if not hasBracket then
        return false, tSeed, d1_0
    end

    local tCur
    if f0 <= 0.0 then
        tCur = (tL * fU - tU * fL) / (fU - fL)
    else
        tCur = 0.5 * (tL + tU)
    end
    local fPrev = abs(fL - fU)
    local d1Final = d1_0

    for _ = 1, 4 do
        local F, D1, H2 = evalArcJet(tCur)
        d1Final = D1
        local absF = abs(F)
        if absF <= tol or (tU - tL) <= 1e-11 then
            return true, tCur, D1
        end

        if F > 0.0 then
            tL, fL = tCur, F
        else
            tU, fU = tCur, F
        end

        local d1Sq = D1 * D1
        local fh2 = F * H2
        local dtStep
        if d1Sq > 2.0 * abs(fh2) and d1Sq > 1e-12 then
            dtStep = -(F * D1) / (d1Sq - fh2)
        else
            local disc = max(0.0, d1Sq - 4.0 * fh2)
            local denom = D1 - sqrt(disc)
            if abs(denom) > 1e-12 then
                dtStep = (-2.0 * F) / denom
            else
                dtStep = 0.0
            end
        end

        local tTrial = tCur + dtStep
        if tTrial > tL and tTrial < tU and absF < 0.55 * fPrev then
            tCur = tTrial
        else
            local tSec = (tL * fU - tU * fL) / (fU - fL)
            tCur = 0.5 * (tSec + 0.5 * (tL + tU))
        end
        fPrev = absF
    end

    return true, tCur, d1Final
end

local function solveSingleEntityBallistic(
    pe0x, pe0y, pe0z,
    ve0x, ve0y, ve0z,
    aex, aey, aez,
    omega,
    errTrack,
    sWarm,
    sigP, sigV, sigA,
    psx, psy, psz,
    vsx, vsy, vsz,
    vProj,
    gx, gy, gz,
    kappaInherit,
    pingOneWay,
    tMax
)
    if vProj <= 1e-5 then
        return false, 0.0, 0.0, 0.0, pe0x, pe0y, pe0z, pe0x, pe0y, pe0z, 0.0, 0.0, -1.0, 0.0, 28.0, 0.15, 0
    end

    local tau = max(0.0, pingOneWay)
    local pex, pey, pez
    local vex, vey, vez
    local axEff, ayEff, azEff

    if abs(omega) > 1e-4 then
        local thetaLat = omega * tau
        local s1, s2, cosLat, sinLat
        if abs(thetaLat) < 1e-4 then
            local th2 = thetaLat * thetaLat
            s1 = 1.0 - th2 * (0.16666666666666666 - th2 * 0.008333333333333333)
            s2 = thetaLat * (0.5 - th2 * 0.041666666666666664)
            cosLat = 1.0 - 0.5 * th2
            sinLat = thetaLat * s1
        else
            sinLat = sin(thetaLat)
            cosLat = cos(thetaLat)
            s1 = sinLat / thetaLat
            s2 = (1.0 - cosLat) / thetaLat
        end
        pex = pe0x + tau * (s1 * ve0x - s2 * ve0z)
        pez = pe0z + tau * (s1 * ve0z + s2 * ve0x)
        pey = pe0y + ve0y * tau + 0.5 * aey * tau * tau

        vex = ve0x * cosLat - ve0z * sinLat
        vez = ve0z * cosLat + ve0x * sinLat
        vey = ve0y + aey * tau

        axEff = -omega * vez
        ayEff = aey
        azEff = omega * vex
    else
        local halfTauSq = 0.5 * tau * tau
        pex = pe0x + ve0x * tau + aex * halfTauSq
        pey = pe0y + ve0y * tau + aey * halfTauSq
        pez = pe0z + ve0z * tau + aez * halfTauSq

        vex = ve0x + aex * tau
        vey = ve0y + aey * tau
        vez = ve0z + aez * tau

        axEff = aex
        ayEff = aey
        azEff = aez
    end

    local dx = pex - psx
    local dy = pey - psy
    local dz = pez - psz
    local distSq = dx * dx + dy * dy + dz * dz

    if distSq <= 1e-10 then
        return true, 0.0, 0.0, 1.0, pex, pey, pez, pex, pey, pez, 0.0, 0.0, -1.0, 1.0, 4.0, 0.98, 1
    end

    local dist = sqrt(distSq)
    local invDist = 1.0 / dist
    local invVProj = 1.0 / vProj
    local T0 = dist * invVProj
    local invT0 = 1.0 / T0
    local sMax = max(0.05, tMax * invT0)

    local vInhX = kappaInherit * vsx
    local vInhY = kappaInherit * vsy
    local vInhZ = kappaInherit * vsz

    local vRelX = vex - vInhX
    local vRelY = vey - vInhY
    local vRelZ = vez - vInhZ

    local dgx = axEff - gx
    local dgy = ayEff - gy
    local dgz = azEff - gz

    local dHatX = dx * invDist
    local dHatY = dy * invDist
    local dHatZ = dz * invDist

    local betaX = vRelX * invVProj
    local betaY = vRelY * invVProj
    local betaZ = vRelZ * invVProj

    local halfT0InvV = 0.5 * T0 * invVProj
    local gammaX = dgx * halfT0InvV
    local gammaY = dgy * halfT0InvV
    local gammaZ = dgz * halfT0InvV

    local c4 = gammaX * gammaX + gammaY * gammaY + gammaZ * gammaZ
    local c3 = 2.0 * (betaX * gammaX + betaY * gammaY + betaZ * gammaZ)
    local c2 = (betaX * betaX + betaY * betaY + betaZ * betaZ) + 2.0 * (dHatX * gammaX + dHatY * gammaY + dHatZ * gammaZ) - 1.0
    local c1 = 2.0 * (dHatX * betaX + dHatY * betaY + dHatZ * betaZ)

    local sStar = 1.0
    local d1Star = -2.0
    local hasExactRoot = false
    local regime = 2

    local sMax2 = sMax * sMax
    if c4 <= 1e-12 or (c4 * sMax2 * sMax2 + abs(c3) * sMax2 * sMax < 1e-6) then
        regime = 1
        if abs(c2) <= 1e-12 then
            if c1 < -1e-9 then
                local sRoot = -1.0 / c1
                if sRoot <= sMax then
                    sStar, d1Star, hasExactRoot = sRoot, c1, true
                else
                    sStar, d1Star = sMax, c1
                end
            else
                sStar, d1Star = 0.0, c1
            end
        elseif c2 < 0.0 then
            local disc = max(0.0, c1 * c1 - 4.0 * c2)
            local qRoot = sqrt(disc)
            local sRoot
            if c1 <= 0.0 then
                sRoot = 2.0 / (-c1 + qRoot)
            else
                sRoot = (-c1 - qRoot) / (2.0 * c2)
            end
            if sRoot <= sMax then
                sStar, d1Star, hasExactRoot = sRoot, 2.0 * c2 * sRoot + c1, true
            else
                sStar, d1Star = sMax, 2.0 * c2 * sMax + c1
            end
        else
            if c1 < 0.0 then
                local disc = c1 * c1 - 4.0 * c2
                if disc >= 0.0 then
                    local qRoot = sqrt(disc)
                    local sRoot = 2.0 / (-c1 + qRoot)
                    if sRoot <= sMax then
                        sStar, d1Star, hasExactRoot = sRoot, -qRoot, true
                    else
                        sStar, d1Star = sMax, 2.0 * c2 * sMax + c1
                    end
                else
                    sStar, d1Star = min(sMax, -c1 / (2.0 * c2)), 0.0
                end
            else
                sStar, d1Star = 0.0, c1
            end
        end
        if hasExactRoot and c4 > 1e-12 then
            local fq = (((c4 * sStar + c3) * sStar + c2) * sStar + c1) * sStar + 1.0
            if abs(fq) > 1e-9 then
                local sL = max(0.0, sStar * 0.96)
                local sU = min(sMax, sStar * 1.04 + 1e-5)
                local fL = (((c4 * sL + c3) * sL + c2) * sL + c1) * sL + 1.0
                local fU = (((c4 * sU + c3) * sU + c2) * sU + c1) * sU + 1.0
                if fL > 0.0 and fU <= 0.0 then
                    sStar, d1Star = refineQuarticBracketHalleyITP(c4, c3, c2, c1, sL, fL, sU, fU, sStar)
                end
            end
        end
    else
        local b2Half = 1.5 * c3
        local a2 = 6.0 * c4
        local delta2 = b2Half * b2Half - a2 * c2

        local sL = 0.0
        local fL = 1.0
        local sU = sMax
        local fU = 1.0

        local fMax = (((c4 * sMax + c3) * sMax + c2) * sMax + c1) * sMax + 1.0
        local d1Max = ((4.0 * c4 * sMax + 3.0 * c3) * sMax + 2.0 * c2) * sMax + c1

        if delta2 <= 0.0 then
            if c1 < 0.0 then
                if fMax <= 0.0 and d1Max <= 0.0 then
                    sL, fL, sU, fU = 0.0, 1.0, sMax, fMax
                    hasExactRoot = true
                elseif d1Max > 0.0 then
                    local m1, fm1 = isolateConvexMinimum(c4, c3, c2, c1, 0.0, 1.0, c1, sMax, fMax, d1Max)
                    if fm1 <= 0.0 then
                        sL, fL, sU, fU = 0.0, 1.0, m1, fm1
                        hasExactRoot = true
                    else
                        sStar, d1Star = m1, 0.0
                    end
                else
                    sStar, d1Star = sMax, d1Max
                end
            else
                sStar, d1Star = 0.0, c1
            end
        else
            local sqrtD2 = sqrt(delta2)
            local qInf = -(b2Half + ((b2Half >= 0.0) and sqrtD2 or -sqrtD2))
            local rA = qInf / a2
            local rB = (abs(qInf) > 1e-16) and (c2 / qInf) or 0.0
            local iota1 = min(rA, rB)
            local iota2 = max(rA, rB)

            local p1 = clamp(iota1, 0.0, sMax)
            local p2 = clamp(iota2, 0.0, sMax)

            local fp1 = (p1 > 0.0) and ((((c4 * p1 + c3) * p1 + c2) * p1 + c1) * p1 + 1.0) or 1.0
            local d1p1 = (p1 > 0.0) and (((4.0 * c4 * p1 + 3.0 * c3) * p1 + 2.0 * c2) * p1 + c1) or c1

            local bestCpaS = 0.0
            local bestCpaF = 1.0

            if p1 > 0.0 and c1 < 0.0 then
                if fp1 <= 0.0 and d1p1 <= 0.0 then
                    sL, fL, sU, fU = 0.0, 1.0, p1, fp1
                    hasExactRoot = true
                elseif d1p1 > 0.0 then
                    local m1, fm1 = isolateConvexMinimum(c4, c3, c2, c1, 0.0, 1.0, c1, p1, fp1, d1p1)
                    if fm1 <= 0.0 then
                        sL, fL, sU, fU = 0.0, 1.0, m1, fm1
                        hasExactRoot = true
                    elseif fm1 < bestCpaF then
                        bestCpaS, bestCpaF = m1, fm1
                    end
                elseif fp1 < bestCpaF then
                    bestCpaS, bestCpaF = p1, fp1
                end
            end

            local fp2 = (p2 > p1) and ((((c4 * p2 + c3) * p2 + c2) * p2 + c1) * p2 + 1.0) or fp1
            local d1p2 = (p2 > p1) and (((4.0 * c4 * p2 + 3.0 * c3) * p2 + 2.0 * c2) * p2 + c1) or d1p1

            if not hasExactRoot and p2 > p1 then
                if fp2 <= 0.0 then
                    if d1p1 > 0.0 and d1p2 < 0.0 then
                        local mMax = (p1 * d1p2 - p2 * d1p1) / (d1p2 - d1p1)
                        local fmMax = (((c4 * mMax + c3) * mMax + c2) * mMax + c1) * mMax + 1.0
                        if fmMax > 0.0 then
                            sL, fL, sU, fU = mMax, fmMax, p2, fp2
                        else
                            sL, fL, sU, fU = p1, fp1, mMax, fmMax
                        end
                    else
                        sL, fL, sU, fU = p1, fp1, p2, fp2
                    end
                    hasExactRoot = true
                elseif fp2 < bestCpaF then
                    bestCpaS, bestCpaF = p2, fp2
                end
            end

            if not hasExactRoot and sMax > p2 and d1p2 < 0.0 then
                if fMax <= 0.0 and d1Max <= 0.0 then
                    sL, fL, sU, fU = p2, fp2, sMax, fMax
                    hasExactRoot = true
                elseif d1Max > 0.0 then
                    local m2, fm2 = isolateConvexMinimum(c4, c3, c2, c1, p2, fp2, d1p2, sMax, fMax, d1Max)
                    if fm2 <= 0.0 then
                        sL, fL, sU, fU = p2, fp2, m2, fm2
                        hasExactRoot = true
                    elseif fm2 < bestCpaF then
                        bestCpaS, bestCpaF = m2, fm2
                    end
                elseif fMax < bestCpaF then
                    bestCpaS, bestCpaF = sMax, fMax
                end
            end

            if not hasExactRoot then
                sStar, d1Star = bestCpaS, 0.0
            end
        end

        if hasExactRoot then
            sStar, d1Star = refineQuarticBracketHalleyITP(c4, c3, c2, c1, sL, fL, sU, fU, sWarm)
        end
    end

    local tStar = clamp(sStar * T0, 0.0, tMax)
    if not hasExactRoot then
        regime = 5
    end

    local absOmega = abs(omega)
    local vhSq = vex * vex + vez * vez
    local usedCTRV = false

    if absOmega > 1e-3 and vhSq > 1e-6 then
        local shouldSwitch = (hasExactRoot and absOmega * tStar > 0.35) or (not hasExactRoot)
        if shouldSwitch then
            local vh = sqrt(vhSq)
            local th0 = atan2(vez, vex)
            local tSeed = hasExactRoot and tStar or min(T0, 0.5 * tMax)
            local okArc, tArc, d1Arc = solveCTRVGeodesic(
                dx, dy, dz,
                vh, th0, omega,
                -vInhX, vRelY, -vInhZ,
                -gx, dgy, -gz,
                vProj, tSeed, tMax
            )
            if okArc then
                regime = hasExactRoot and 3 or 4
                hasExactRoot = true
                usedCTRV = true
                tStar = clamp(tArc, 0.0, tMax)
                sStar = tStar * invT0
                d1Star = d1Arc / (dist * vProj)
            end
        end
    end

    local relPx, relPy, relPz
    local relVx, relVy, relVz

    if usedCTRV then
        local vh = sqrt(vhSq)
        local th0 = atan2(vez, vex)
        local u = 0.5 * omega * tStar
        local arc = vh * tStar * sincStable(u)
        local thm = th0 + u
        relPx = dx + arc * cos(thm) - (vInhX + 0.5 * gx * tStar) * tStar
        relPy = dy + (vRelY + 0.5 * dgy * tStar) * tStar
        relPz = dz + arc * sin(thm) - (vInhZ + 0.5 * gz * tStar) * tStar

        local thEnd = th0 + omega * tStar
        relVx = vh * cos(thEnd) - vInhX - gx * tStar
        relVy = vRelY + dgy * tStar
        relVz = vh * sin(thEnd) - vInhZ - gz * tStar
    else
        local halfTSq = 0.5 * tStar * tStar
        relPx = dx + vRelX * tStar + dgx * halfTSq
        relPy = dy + vRelY * tStar + dgy * halfTSq
        relPz = dz + vRelZ * tStar + dgz * halfTSq

        relVx = vRelX + dgx * tStar
        relVy = vRelY + dgy * tStar
        relVz = vRelZ + dgz * tStar
    end

    local aimX = psx + relPx
    local aimY = psy + relPy
    local aimZ = psz + relPz

    local halfTSq = 0.5 * tStar * tStar
    local hitX = aimX + vInhX * tStar + gx * halfTSq
    local hitY = aimY + vInhY * tStar + gy * halfTSq
    local hitZ = aimZ + vInhZ * tStar + gz * halfTSq

    local relLenSq = relPx * relPx + relPy * relPy + relPz * relPz
    local relLen = sqrt(max(1e-10, relLenSq))
    local invRelLen = 1.0 / relLen
    local ux = relPx * invRelLen
    local uy = relPy * invRelLen
    local uz = relPz * invRelLen

    local rDotUnit = ux * relVx + uy * relVy + uz * relVz
    local mu = 1.0 - rDotUnit * invVProj

    local absD1 = abs(d1Star)
    local grazTerm = 0.36 * max(0.1, sStar)
    local phiCond = absD1 / sqrt(absD1 * absD1 + grazTerm * grazTerm)

    local qSq = (relVx * relVx + relVy * relVy + relVz * relVz) * (invVProj * invVProj)
    local qPerpSq = max(0.0, qSq - (rDotUnit * invVProj) * (rDotUnit * invVProj))
    local muSafeSq = max(1e-4, mu * mu)
    local latGainSq = 1.0 + qPerpSq / muSafeSq

    local t2 = tStar * tStar
    local missDist = max(0.0, relLen - vProj * tStar)
    local sigTotSq = latGainSq * (sigP * sigP + sigV * sigV * t2 + 0.25 * sigA * sigA * t2 * t2 + 0.04 * errTrack * errTrack)
        + missDist * missDist

    local hitRatio = 16.0 / max(1e-6, 2.0 * sigTotSq)
    local expNegHit = 1.0 / (1.0 + hitRatio * (1.0 + hitRatio * (0.5 + hitRatio * 0.16666666666666666)))
    local cHit = 1.0 - expNegHit

    local tTotalNorm = (tStar + tau) / max(0.1, tMax)
    local omegaPhase = omega * tStar
    local decayArg = 0.65 * (tTotalNorm * tTotalNorm) + 0.15 * (omegaPhase * omegaPhase)
    local padeHorizon = 1.0 / (1.0 + decayArg * (1.0 + decayArg * (0.5 + decayArg * 0.16666666666666666)))

    local cpaPenalty = hasExactRoot and 1.0 or 0.30
    local confidence = clamp(phiCond * cHit * padeHorizon * cpaPenalty, 0.0, 1.0)

    local reticleRadius = 4.0 + 24.0 * (1.0 - confidence)
    local reticleOpacity = 0.15 + 0.83 * confidence

    return hasExactRoot, tStar, sStar, mu, aimX, aimY, aimZ, hitX, hitY, hitZ, ux, uy, uz, confidence, reticleRadius, reticleOpacity, regime
end

local function solveSemiconvexSSN(
    pe0x, pe0y, pe0z,
    ve0x, ve0y, ve0z,
    aex, aey, aez,
    omega,
    sWarm,
    psx, psy, psz,
    vsx, vsy, vsz,
    vProj,
    gx, gy, gz,
    kappaInherit,
    pingOneWay,
    tMax
)
    if vProj <= 1e-5 then
        return false, 0.0, pe0x, pe0y, pe0z, 0
    end

    local tau = max(0.0, pingOneWay)
    local thLat = omega * tau
    local s1 = sincStable(thLat)
    local s2 = (abs(thLat) < 1e-4) and (0.5 * thLat) or ((1.0 - cos(thLat)) / thLat)
    local cosLat = cos(thLat)
    local sinLat = sin(thLat)
    local halfTauSq = 0.5 * tau * tau

    local dx = pe0x + tau * (s1 * ve0x - s2 * ve0z) + aex * halfTauSq - psx
    local dy = pe0y + ve0y * tau + aey * halfTauSq - psy
    local dz = pe0z + tau * (s1 * ve0z + s2 * ve0x) + aez * halfTauSq - psz

    local D = sqrt(dx * dx + dy * dy + dz * dz)
    if D <= 1e-5 then
        return true, 0.0, psx + dx, psy + dy, psz + dz, 6
    end

    local invD = 1.0 / D
    local invV = 1.0 / vProj
    local T0 = D * invV
    local sMax = tMax / T0

    local ex, ey, ez = dx * invD, dy * invD, dz * invD
    local bx = (ve0x * cosLat - ve0z * sinLat) * invV
    local bz = (ve0x * sinLat + ve0z * cosLat) * invV
    local lx = (aex * tau - kappaInherit * vsx) * invV
    local ly = (ve0y + aey * tau - kappaInherit * vsy) * invV
    local lz = (aez * tau - kappaInherit * vsz) * invV

    local fa = D * invV * invV
    local kx, ky, kz = (aex - gx) * fa, (aey - gy) * fa, (aez - gz) * fa
    local wN = omega * T0
    local K = sqrt(kx * kx + ky * ky + kz * kz) + abs(wN) * sqrt(bx * bx + bz * bz)

    local s = (sWarm > 0.0) and (0.995 * sWarm) or 0.0
    local checkWarm = s > 0.0
    local rx, ry, rz = ex, ey, ez
    local qx, qy, qz = 0.0, 0.0, 0.0
    local G = 1.0
    local dG = -1.0
    local converged = false

    for _ = 1, 8 do
        local th = wN * s
        local Sx = s * sincStable(th)
        local Cx = (abs(th) < 1e-4) and (0.5 * s * th) or (s * (1.0 - cos(th)) / th)
        local sn, cs = sin(th), cos(th)

        rx = ex + (lx + 0.5 * kx * s) * s + bx * Sx - bz * Cx
        ry = ey + (ly + 0.5 * ky * s) * s
        rz = ez + (lz + 0.5 * kz * s) * s + bz * Sx + bx * Cx

        qx = lx + kx * s + bx * cs - bz * sn
        qy = ly + ky * s
        qz = lz + kz * s + bz * cs + bx * sn

        local N = sqrt(max(1e-16, rx * rx + ry * ry + rz * rz))
        G = N - s
        dG = (rx * qx + ry * qy + rz * qz) / N - 1.0

        local skipStep = false
        if checkWarm then
            checkWarm = false
            if not (G > 0.0 and (G - dG * s - 0.5 * K * s * s) > 0.0) then
                s = 0.0
                skipStep = true
            end
        end

        if not skipStep then
            if G <= 1e-6 then
                converged = true
                break
            end

            local disc = sqrt(max(0.0, dG * dG + 2.0 * K * G))
            local step = (dG <= 0.0) and ((2.0 * G) / (disc - dG)) or ((disc + dG) / max(1e-12, K))
            s = s + step
            if s > sMax then
                return false, sMax * T0, psx + dx, psy + dy, psz + dz, 5
            end
        end
    end

    if converged and dG < -1e-6 then
        local dl = -G / dG
        s = s + dl
        rx = rx + qx * dl
        ry = ry + qy * dl
        rz = rz + qz * dl
    end

    local tStar = s * T0
    local aimX = psx + rx * D
    local aimY = psy + ry * D
    local aimZ = psz + rz * D
    return converged, tStar, aimX, aimY, aimZ, 6
end

immCore = {
    ResetEntity        = resetImmEntity,
    StepEntity         = stepImmCore,
    PredictPosition    = predictImmPosition,
    ReadSnapshot       = readImmSnapshot,
    SolveBallistic     = solveSingleEntityBallistic,
    SolveSemiconvexSSN = solveSemiconvexSSN,
    UpdateYawAlphaBeta = updateYawRateAlphaBeta,
}

stepEntityKinematics = function(slot, dt, now, rawPos, rawVel, walkSpeed, leadTime, shooterPos, shooterVel, sWarmPrev)
    local eBar, agility, aperiodicity, behLabel = stepImmCore(
        slot, dt, now, rawPos.X, rawPos.Y, rawPos.Z, walkSpeed
    )
    local snap = readImmSnapshot(slot)
    local blendedVel = Vector3.new(snap.vx, rawVel.Y, snap.vz)
    if blendedVel.Magnitude < 0.5 and rawVel.Magnitude > 0.5 then
        blendedVel = rawVel
    end
    local vProj = state.espProjectileSpeed or 450
    local ps = shooterPos or rawPos
    local vs = shooterVel or Vector3.zero
    local okPing, rawPing = pcall(function() return LocalPlayer:GetNetworkPing() end)
    local pingOneWay = (okPing and type(rawPing) == "number") and clamp(rawPing * 0.5, 0.0, 0.25) or 0.03
    local hasRoot, tStar, sStar, mu, aimX, aimY, aimZ, hitX, hitY, hitZ, ux, uy, uz, conf, retRad, retAlpha, regime =
        solveSingleEntityBallistic(
            snap.px, snap.py, snap.pz,
            blendedVel.X, blendedVel.Y, blendedVel.Z,
            snap.ax, snap.ay, snap.az,
            snap.omega,
            snap.eBar * 10.0,
            sWarmPrev or 0.0,
            snap.sigP, snap.sigV, snap.sigA,
            ps.X, ps.Y, ps.Z,
            vs.X, vs.Y, vs.Z,
            vProj,
            0.0, 0.0, 0.0,
            0.0,
            pingOneWay,
            3.5
        )
    local leadVec
    if hasRoot and tStar > 0.001 then
        leadVec = Vector3.new(aimX, aimY, aimZ)
    else
        local px, py, pz = predictImmPosition(slot, leadTime)
        leadVec = Vector3.new(px, py, pz)
    end
    return leadVec, blendedVel, eBar, agility, aperiodicity, behLabel, snap.jukeOnset, snap.muCTRV, sStar, tStar, conf, retRad, retAlpha, regime
end
end
local function computeGroundClampedBallisticArc(originPos, smoothVel, gravity, rayParams, allowRaycast)
    local g = math.max(1, gravity)
    local vy = smoothVel.Y
    local disc = vy * vy + 2.0 * g * 32.0
    local maxFlightT = math.clamp((vy + math.sqrt(math.max(0, disc))) / g, 0.25, 1.40)
    local stepT = maxFlightT * 0.25

    scratchBallisticPts[1] = originPos
    local validCount = 1
    local impactWorld = nil

    for seg = 1, 4 do
        local t = seg * stepT
        local nextPt = Vector3.new(
            originPos.X + smoothVel.X * t,
            originPos.Y + vy * t - 0.5 * g * (t * t),
            originPos.Z + smoothVel.Z * t
        )
        local prevPt = scratchBallisticPts[seg]
        if allowRaycast and nextPt.Y <= prevPt.Y then
            local hit = Workspace:Raycast(prevPt, nextPt - prevPt, rayParams)
            if hit then
                validCount = validCount + 1
                scratchBallisticPts[validCount] = hit.Position
                impactWorld = hit.Position
                break
            end
        end
        validCount = validCount + 1
        scratchBallisticPts[validCount] = nextPt
        impactWorld = nextPt
    end

    return validCount, impactWorld
end

local resetSapLabels, registerSapLabel, solveAndCommitSapLabels
do
local MAX_SAP_LABELS = 48
local sapPool        = table.create(MAX_SAP_LABELS)
local sapActiveCount = 0

for i = 1, MAX_SAP_LABELS do
    sapPool[i] = {
        frame  = nil,
        cx     = 0,
        cy     = 0,
        origY  = 0,
        halfW  = 50,
        halfH  = 8,
        minX   = 0,
        maxX   = 0,
        weight = 1,
    }
end

resetSapLabels = function()
    sapActiveCount = 0
end

registerSapLabel = function(labelGui, centerX, centerY, width, height, priorityWeight)
    if sapActiveCount >= MAX_SAP_LABELS then
        labelGui.Position = UDim2.fromOffset(math.floor(centerX + 0.5), math.floor(centerY + 0.5))
        return
    end
    sapActiveCount = sapActiveCount + 1
    local node  = sapPool[sapActiveCount]
    local hw    = width * 0.5
    node.frame  = labelGui
    node.cx     = centerX
    node.cy     = centerY
    node.origY  = centerY
    node.halfW  = hw
    node.halfH  = height * 0.5
    node.minX   = centerX - hw
    node.maxX   = centerX + hw
    node.weight = priorityWeight
end

solveAndCommitSapLabels = function(viewportHeight)
    local n = sapActiveCount
    if n <= 1 then
        if n == 1 then
            local node = sapPool[1]
            node.frame.Position = UDim2.fromOffset(math.floor(node.cx + 0.5), math.floor(node.cy + 0.5))
        end
        return
    end

    for i = 2, n do
        local key = sapPool[i]
        local keyMinX = key.minX
        local j = i - 1
        while j >= 1 and sapPool[j].minX > keyMinX do
            sapPool[j + 1] = sapPool[j]
            j = j - 1
        end
        sapPool[j + 1] = key
    end

    for _ = 1, 2 do
        for i = 1, n - 1 do
            local a = sapPool[i]
            local aMaxX = a.maxX
            for j = i + 1, n do
                local b = sapPool[j]
                if b.minX >= aMaxX then
                    break
                end
                local reqSepY = a.halfH + b.halfH + 2.0
                local dy = b.cy - a.cy
                local absDy = math.abs(dy)
                if absDy < reqSepY then
                    local overlap = reqSepY - absDy
                    local dir = (dy >= 0) and 1.0 or -1.0
                    local totalW = a.weight + b.weight
                    local ratioA = b.weight / totalW
                    local ratioB = a.weight / totalW
                    a.cy = math.clamp(a.cy - dir * overlap * ratioA, 14, viewportHeight - 14)
                    b.cy = math.clamp(b.cy + dir * overlap * ratioB, 14, viewportHeight - 14)
                end
            end
        end
    end

    for i = 1, n do
        local node = sapPool[i]
        node.frame.Position = UDim2.fromOffset(math.floor(node.cx + 0.5), math.floor(node.cy + 0.5))
    end
end

end
local classifyTargetActionState
do
local ACTION_KEYWORDS = {
    { token = "reload",  badge = "RELOADING", priority = 10 },
    { token = "heal",    badge = "HEALING",   priority = 9 },
    { token = "bandage", badge = "HEALING",   priority = 9 },
    { token = "drink",   badge = "CONSUMING", priority = 8 },
    { token = "swing",   badge = "ATTACKING", priority = 8 },
    { token = "slash",   badge = "ATTACKING", priority = 8 },
    { token = "punch",   badge = "ATTACKING", priority = 8 },
    { token = "shoot",   badge = "FIRING",    priority = 8 },
    { token = "fire",    badge = "FIRING",    priority = 8 },
    { token = "block",   badge = "BLOCKING",  priority = 7 },
    { token = "parry",   badge = "PARRYING",  priority = 7 },
    { token = "aim",     badge = "ADS / AIM", priority = 6 },
}

classifyTargetActionState = function(entry, now, char, hum, flatSpeed)
    local hState = hum:GetState()
    if hState == Enum.HumanoidStateType.Climbing then
        return "CLIMBING"
    elseif hState == Enum.HumanoidStateType.Swimming then
        return "SWIMMING"
    elseif hState == Enum.HumanoidStateType.FallingDown or hState == Enum.HumanoidStateType.Ragdoll then
        return "RAGDOLLED"
    elseif hum.Sit then
        local seat = hum.SeatPart
        if seat and seat:IsA("VehicleSeat") then
            return "DRIVING"
        end
        return "SEATED"
    end

    if now >= (entry.nextAnimScanAt or 0) then
        entry.nextAnimScanAt = now + 0.15
        local detectedBadge = nil
        local bestPrio = 0
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
            if ok and tracks then
                for i = 1, #tracks do
                    local tr = tracks[i]
                    if tr.IsPlaying and tr.WeightCurrent > 0.2 then
                        local anim = tr.Animation
                        local rawName = string.lower((tr.Name or "") .. " " .. (anim and anim.Name or ""))
                        for k = 1, #ACTION_KEYWORDS do
                            local rule = ACTION_KEYWORDS[k]
                            if rule.priority > bestPrio and string.find(rawName, rule.token, 1, true) then
                                detectedBadge = rule.badge
                                bestPrio = rule.priority
                            end
                        end
                        if not detectedBadge and tr.Priority == Enum.AnimationPriority.Action4 then
                            detectedBadge = "ABILITY"
                        end
                    end
                end
            end
        end
        entry.cachedActionBadge = detectedBadge
    end

    if entry.cachedActionBadge then
        return entry.cachedActionBadge
    end

    if hState == Enum.HumanoidStateType.Jumping or hState == Enum.HumanoidStateType.Freefall then
        return "AIRBORNE"
    elseif flatSpeed > 22 then
        return string.format("SPRINT (%d)", math.floor(flatSpeed + 0.5))
    elseif flatSpeed > 2 then
        return string.format("MOVE (%d)", math.floor(flatSpeed + 0.5))
    end
    return "IDLE"
end

end
local function pushEntityTrailSample(slot, now, pos, lastSampleAt)
    if now - lastSampleAt < 0.10 then
        return lastSampleAt
    end
    local base    = (slot - 1) * ENTITY_STRIDE
    local headIdx = BufferLib.readu8(entitySoABuffer, base + 56)
    local count   = BufferLib.readu8(entitySoABuffer, base + 57)

    if count > 0 then
        local prevOffset = base + TRAIL_BASE_OFFSET + ((headIdx - 1) * 12)
        local dx = pos.X - BufferLib.readf32(entitySoABuffer, prevOffset)
        local dy = pos.Y - BufferLib.readf32(entitySoABuffer, prevOffset + 4)
        local dz = pos.Z - BufferLib.readf32(entitySoABuffer, prevOffset + 8)
        if (dx * dx + dy * dy + dz * dz) < 1.44 then
            return lastSampleAt
        end
    end

    local nextHead = (headIdx % TRAIL_CAP) + 1
    local writeOff = base + TRAIL_BASE_OFFSET + ((nextHead - 1) * 12)
    BufferLib.writef32(entitySoABuffer, writeOff, pos.X)
    BufferLib.writef32(entitySoABuffer, writeOff + 4, pos.Y)
    BufferLib.writef32(entitySoABuffer, writeOff + 8, pos.Z)
    BufferLib.writeu8(entitySoABuffer, base + 56, nextHead)
    if count < TRAIL_CAP then
        BufferLib.writeu8(entitySoABuffer, base + 57, count + 1)
    end
    return now
end

local function evaluateAimConeSeverity(enemyChar, enemyHrp, myOriginPos, camCF, dist, isVisible)
    if not state.espAimAlert or dist > 220 or dist < 0.5 then
        return 0, nil
    end
    local head = enemyChar:FindFirstChild("Head")
    local origin = (head and head:IsA("BasePart")) and head.Position or enemyHrp.Position
    local toMe = myOriginPos - origin
    local d = toMe.Magnitude
    if d < 0.5 then return 0, nil end
    local unitToMe = toMe / d

    local lookHead = (head and head:IsA("BasePart")) and head.CFrame.LookVector or enemyHrp.CFrame.LookVector
    local maxDot   = lookHead:Dot(unitToMe)

    local tool = enemyChar:FindFirstChildOfClass("Tool")
    local handle = tool and tool:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        local toolDot = handle.CFrame.LookVector:Dot(unitToMe)
        if toolDot > maxDot then maxDot = toolDot end
    end

    if maxDot < 0.85 then
        return 0, nil
    end

    local sinSq    = math.max(0, 1.0 - maxDot * maxDot)
    local missDist = d * math.sqrt(sinSq)
    local sev = 0
    if maxDot >= 0.965 and missDist <= 4.5 and (isVisible or dist <= 55) then
        sev = 2
    elseif missDist <= (3.2 + 0.04 * d) and (isVisible or dist <= 85) then
        sev = 1
    end
    if sev == 0 then return 0, nil end

    local rel = camCF:PointToObjectSpace(enemyHrp.Position)
    local angDeg = math.deg(math.atan2(rel.X, -rel.Z))
    local dirTag = "FRONT"
    if angDeg > 45 and angDeg <= 135 then
        dirTag = "RIGHT"
    elseif angDeg < -45 and angDeg >= -135 then
        dirTag = "LEFT"
    elseif math.abs(angDeg) > 135 then
        dirTag = "REAR"
    end
    return sev, dirTag
end

