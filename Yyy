local function createRadialActionWheel(actionsList)
    local wheelRoot = Instance.new("Frame")
    wheelRoot.Name                   = "TacticalRadialWheel"
    wheelRoot.AnchorPoint            = Vector2.new(0.5, 0.5)
    wheelRoot.Position               = UDim2.fromScale(0.5, 0.5)
    wheelRoot.Size                   = UDim2.fromOffset(236, 236)
    wheelRoot.BackgroundTransparency = 1
    wheelRoot.Visible                = false
    wheelRoot.ZIndex                 = 10
    wheelRoot.Parent                 = screenGui

    local wheelScale = Instance.new("UIScale")
    wheelScale.Scale  = 0.2
    wheelScale.Parent = wheelRoot

    local centerHub = Instance.new("TextButton")
    centerHub.AnchorPoint      = Vector2.new(0.5, 0.5)
    centerHub.Position         = UDim2.fromScale(0.5, 0.5)
    centerHub.Size             = UDim2.fromOffset(62, 62)
    centerHub.BackgroundColor3 = Theme.BgHeader
    centerHub.AutoButtonColor  = false
    centerHub.BorderSizePixel  = 0
    centerHub.Text             = ""
    centerHub.ZIndex           = 11
    centerHub.Parent           = wheelRoot
    Instance.new("UICorner", centerHub).CornerRadius = UDim.new(1, 0)

    local centerStroke = Instance.new("UIStroke")
    centerStroke.Thickness = 1.5
    centerStroke.Color     = Theme.Accent
    centerStroke.Parent    = centerHub
    onAccentChanged(function(accent) centerStroke.Color = accent end)

    local centerLbl = Instance.new("TextLabel")
    centerLbl.Size                   = UDim2.fromScale(1, 1)
    centerLbl.BackgroundTransparency = 1
    centerLbl.Font                   = Enum.Font.GothamBold
    centerLbl.TextSize               = 9
    centerLbl.TextColor3             = Theme.TextPrimary
    centerLbl.Text                   = "CLOSE"
    centerLbl.ZIndex                 = 12
    centerLbl.Parent                 = centerHub

    local isOpen = false
    local scaleSpring = SpringEngine:bind1D(0.2, 26.0, function(val)
        wheelScale.Scale = val
        if not isOpen and val <= 0.25 then
            wheelRoot.Visible = false
        end
    end)

    local sectorCards = {}
    local numSectors  = #actionsList
    local radiusPx    = 86

    local api = {}

    for i = 1, numSectors do
        local ang = (i - 1) * (math.pi * 2 / numSectors) - (math.pi * 0.5)
        local ox  = math.cos(ang) * radiusPx
        local oy  = math.sin(ang) * radiusPx

        local card = Instance.new("TextButton")
        card.Name             = "Sector_" .. i
        card.AnchorPoint      = Vector2.new(0.5, 0.5)
        card.Position         = UDim2.new(0.5, math.floor(ox + 0.5), 0.5, math.floor(oy + 0.5))
        card.Size             = UDim2.fromOffset(68, 28)
        card.BackgroundColor3 = Theme.BgRow
        card.AutoButtonColor  = false
        card.BorderSizePixel  = 0
        card.Font             = Enum.Font.GothamBold
        card.TextSize         = 9
        card.TextColor3       = Theme.TextPrimary
        card.Text             = actionsList[i].label
        card.ZIndex           = 11
        card.Parent           = wheelRoot
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 7)

        local st = Instance.new("UIStroke")
        st.Thickness = 1.2
        st.Color     = Theme.Stroke
        st.Parent    = card

        sectorCards[i] = { card = card, stroke = st, action = actionsList[i].onTrigger }
        table.insert(connections, card.MouseButton1Click:Connect(function()
            local fn = actionsList[i].onTrigger
            isOpen = false
            scaleSpring:setGoal(0.2)
            if fn then task.spawn(fn) end
        end))
    end

    table.insert(connections, centerHub.MouseButton1Click:Connect(function()
        isOpen = false
        scaleSpring:setGoal(0.2)
    end))

    local originPt     = Vector2.zero
    local selectedSlot = 0

    local function updateSelection(cursorPt)
        local delta = cursorPt - originPt
        if delta.Magnitude < 26 then
            selectedSlot = 0
            centerLbl.Text = "CLOSE"
            centerLbl.TextColor3 = Theme.TextMuted
            for i = 1, numSectors do
                sectorCards[i].card.BackgroundColor3 = Theme.BgRow
                sectorCards[i].stroke.Color = Theme.Stroke
            end
            return
        end

        local angle = math.atan2(delta.Y, delta.X) + (math.pi * 0.5)
        local step  = (math.pi * 2) / numSectors
        local norm  = (angle + step * 0.5) % (math.pi * 2)
        local idx   = (math.floor(norm / step) % numSectors) + 1
        selectedSlot = idx
        centerLbl.Text = actionsList[idx].label
        centerLbl.TextColor3 = Theme.Accent

        for i = 1, numSectors do
            local active = (i == idx)
            sectorCards[i].card.BackgroundColor3 = active and Theme.BgRowHover or Theme.BgRow
            sectorCards[i].stroke.Color = active and Theme.Accent or Theme.Stroke
        end
    end

    function api:openAt(screenPt)
        originPt = screenPt
        selectedSlot = 0
        isOpen = true
        wheelRoot.Position = UDim2.fromOffset(screenPt.X, screenPt.Y)
        wheelRoot.Visible = true
        updateSelection(screenPt)
        scaleSpring:setGoal(1.0)
    end

    function api:toggleCentered()
        if isOpen then
            isOpen = false
            scaleSpring:setGoal(0.2)
        else
            local cam = Workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
            self:openAt(Vector2.new(vp.X * 0.5, vp.Y * 0.5))
        end
    end

    function api:moveCursor(screenPt)
        if not isOpen then return end
        updateSelection(screenPt)
    end

    function api:commitAndClose()
        if not isOpen then return end
        isOpen = false
        scaleSpring:setGoal(0.2)
        if selectedSlot >= 1 and selectedSlot <= numSectors then
            local fn = sectorCards[selectedSlot].action
            if fn then task.spawn(fn) end
        end
    end

    return api
end

