    sliderThumb.BorderSizePixel  = 0
    Instance.new("UICorner", sliderThumb).CornerRadius = UDim.new(1, 0)

    local currentVal = defaultVal
    local isOn = false
    local api = {
        key      = text,
        button   = topBtn,
        input    = valuePill,
        isOn     = function() return isOn end,
        getValue = function() return currentVal end,
    }
    table.insert(toggleApis, api)
    toggleRegistry[text] = api

    local function formatVal(v)
        if decimals <= 0 then
            return tostring(math.floor(v + 0.5))
        end
        return string.format("%." .. tostring(decimals) .. "f", v)
    end

    local function setSliderValue(raw, notify)
        local factor = 10 ^ decimals
        local clamped = math.clamp(raw, minVal, maxVal)
        currentVal = math.floor(clamped * factor + 0.5) / factor
        local alpha = math.clamp((currentVal - minVal) / math.max(1e-6, maxVal - minVal), 0, 1)
        sliderFill.Size = UDim2.fromScale(alpha, 1)
        valuePill.Text = formatVal(currentVal)
        if notify and onValue then
            pcall(onValue, currentVal)
        end
    end
    api.setValue = function(v) setSliderValue(v, true) end
    setSliderValue(defaultVal, false)

    local function updateFromScreenX(screenX)
        local trackX = sliderTrack.AbsolutePosition.X
        local trackW = math.max(1, sliderTrack.AbsoluteSize.X)
        local alpha = math.clamp((screenX - trackX) / trackW, 0, 1)
        setSliderValue(minVal + (maxVal - minVal) * alpha, true)
    end

    table.insert(connections, sliderHitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            updateFromScreenX(input.Position.X)
            activeSliderDrag = {
                input = input,
                updateFromX = updateFromScreenX,
            }
        end
    end))

    table.insert(connections, valuePill.Focused:Connect(function()
        TweenService:Create(pillStroke, TweenFast, { Color = Theme.StrokeFocus }):Play()
    end))

    table.insert(connections, valuePill.FocusLost:Connect(function()
        TweenService:Create(pillStroke, TweenFast, { Color = Theme.Stroke }):Play()
        local parsed = tonumber(valuePill.Text)
        if not parsed then
            setSliderValue(defaultVal, true)
        else
            setSliderValue(parsed, true)
        end
    end))

    local function animateSwitch(on)
        TweenService:Create(switchTrack, TweenSwitch, {
            BackgroundColor3 = on and Theme.Accent or Theme.SwitchOff,
        }):Play()
        TweenService:Create(switchKnob, TweenSwitch, {
            Position = on and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        }):Play()
        TweenService:Create(accentBar, TweenSwitch, {
            BackgroundColor3 = on and Theme.Accent or Theme.SwitchOff,
        }):Play()
        TweenService:Create(cardStroke, TweenSwitch, {
            Color = on and Theme.Accent or Theme.Stroke,
            Transparency = on and 0.35 or 0.25,
        }):Play()
    end

    onAccentChanged(function()
        if isOn then animateSwitch(true) end
    end)

    function api.setState(on)
        on = not not on
        if isOn == on then return end
        isOn = on
        animateSwitch(on)

        local success, err = pcall(onToggle, on)
        if not success then
            warn("[Johan Hub] Failed to toggle " .. text .. ": " .. tostring(err))
            isOn = not on
            animateSwitch(isOn)
            pcall(onToggle, isOn)
            return false
        end
        return true
    end

    table.insert(connections, topBtn.MouseButton1Click:Connect(function()
        if UserInputService:GetFocusedTextBox() == valuePill then return end
        api.setState(not isOn)
    end))

    table.insert(connections, card.MouseEnter:Connect(function()
        TweenService:Create(card, TweenFast, { BackgroundColor3 = Theme.BgRowHover }):Play()
    end))

    table.insert(connections, card.MouseLeave:Connect(function()
        TweenService:Create(card, TweenFast, { BackgroundColor3 = Theme.BgRow }):Play()
    end))

    return api
end

