local function disconnectAll()
    if closed then return end
    closed = true
    cancelActiveGlide()
    state.espEnabled = false
    state.waypointEsp = false
    refreshEspLoopState()
    for _, wp in ipairs(waypoints) do
        if wp.marker then pcall(function() wp.marker:Destroy() end) end
    end
    table.clear(waypoints)
    for i = 1, #damagePopupPool do
        if damagePopupPool[i] then pcall(function() damagePopupPool[i]:Destroy() end) end
    end
    for i = 1, #objectEspPool do
        if objectEspPool[i] and objectEspPool[i].holder then
            pcall(function() objectEspPool[i].holder:Destroy() end)
        end
    end
    SmartObjectScanner:stop()
    setAntiFling(false)
    state.fullbright = false
    state.noFog = false
    state.spectateTarget = false
    pcall(function()
        local cam = Workspace.CurrentCamera
        local myHum = getHumanoid()
        if cam and myHum and cam.CameraType == Enum.CameraType.Custom then
            cam.CameraSubject = myHum
        end
    end)
    syncLightingOverrides()
    if speedLock then pcall(function() speedLock:uninstall() end) end
    if gravityLock then pcall(function() gravityLock:uninstall() end) end
    if fovLock then pcall(function() fovLock:uninstall() end) end
    if viewportConnection then
        pcall(function() viewportConnection:Disconnect() end)
        viewportConnection = nil
    end
    if statusLoopConnection then
        pcall(function() statusLoopConnection:Disconnect() end)
        statusLoopConnection = nil
    end
    infiniteJumpEnabled = false
    stopNoclipLoop()
    for _, connection in ipairs(connections) do
        if typeof(connection) == "RBXScriptConnection" and connection.Connected then
            pcall(function() connection:Disconnect() end)
        end
    end
    table.clear(connections)
end
