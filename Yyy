local function updateModeJoseph(b, sOff, pOff, zx, zy, zz, rMeas, isCV)
    local px = BufferLib.readf32(b, sOff + 0)
    local vx = BufferLib.readf32(b, sOff + 4)
    local ax = BufferLib.readf32(b, sOff + 8)
    local py = BufferLib.readf32(b, sOff + 12)
    local vy = BufferLib.readf32(b, sOff + 16)
    local ay = BufferLib.readf32(b, sOff + 20)
    local pz = BufferLib.readf32(b, sOff + 24)
    local vz = BufferLib.readf32(b, sOff + 28)
    local az = BufferLib.readf32(b, sOff + 32)

    local Ppp = BufferLib.readf32(b, pOff + 0)
    local Ppv = BufferLib.readf32(b, pOff + 4)
    local Ppa = BufferLib.readf32(b, pOff + 8)
    local Pvv = BufferLib.readf32(b, pOff + 12)
    local Pva = BufferLib.readf32(b, pOff + 16)
    local Paa = BufferLib.readf32(b, pOff + 20)

    local yx = zx - px
    local yy = zy - py
    local yz = zz - pz
    local s = math.max(1e-6, Ppp + rMeas)
    local invS = 1.0 / s
    local nis = (yx * yx + yy * yy + yz * yz) * invS

    local Kp = Ppp * invS
    local Kv = Ppv * invS
    local Ka = isCV and 0.0 or (Ppa * invS)

    BufferLib.writef32(b, sOff + 0, px + Kp * yx)
    BufferLib.writef32(b, sOff + 4, vx + Kv * yx)
    BufferLib.writef32(b, sOff + 8, isCV and ax or (ax + Ka * yx))
    BufferLib.writef32(b, sOff + 12, py + Kp * yy)
    BufferLib.writef32(b, sOff + 16, vy + Kv * yy)
    BufferLib.writef32(b, sOff + 20, isCV and ay or (ay + Ka * yy))
    BufferLib.writef32(b, sOff + 24, pz + Kp * yz)
    BufferLib.writef32(b, sOff + 28, vz + Kv * yz)
    BufferLib.writef32(b, sOff + 32, isCV and az or (az + Ka * yz))

    local a0 = 1.0 - Kp
    local nPpp = a0 * a0 * Ppp + rMeas * Kp * Kp
    local nPpv = a0 * (Ppv - Kv * Ppp) + rMeas * Kp * Kv
    local nPpa = a0 * (Ppa - Ka * Ppp) + rMeas * Kp * Ka
    local nPvv = Pvv - 2.0 * Kv * Ppv + (Kv * Kv) * s
    local nPva = Pva - Kv * Ppa - Ka * Ppv + Kv * Ka * s
    local nPaa = Paa - 2.0 * Ka * Ppa + (Ka * Ka) * s

    BufferLib.writef32(b, pOff + 0, math.max(1e-5, nPpp))
    BufferLib.writef32(b, pOff + 4, nPpv)
    BufferLib.writef32(b, pOff + 8, nPpa)
    BufferLib.writef32(b, pOff + 12, math.max(1e-4, nPvv))
    BufferLib.writef32(b, pOff + 16, nPva)
    BufferLib.writef32(b, pOff + 20, math.max(1e-3, nPaa))

    return s, nis
end

