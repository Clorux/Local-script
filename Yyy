local function makeDraggable(targetObj, handleObj, onClickCallback)
    handleObj = handleObj or targetObj
    local dragStartPos = nil
    local wasDragged = false

    table.insert(connections, handleObj.InputBegan:Connect(function(input)
        if activeSliderDrag then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragStartPos = input.Position
            wasDragged = false
            activeDrag = {
                obj = targetObj,
                input = input,
                startPos = targetObj.Position,
                dragStart = input.Position,
                markDragged = function()
                    wasDragged = true
                end,
            }
        end
    end))

    if type(onClickCallback) == "function" then
        table.insert(connections, handleObj.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                local movedDist = dragStartPos and (input.Position - dragStartPos).Magnitude or 0
                if not wasDragged and movedDist < 8 then
                    onClickCallback()
                end
            end
        end))
    end
end

table.insert(connections, UserInputService.InputChanged:Connect(function(input)
    if activeSliderDrag then
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or (input.UserInputType == Enum.UserInputType.Touch and input == activeSliderDrag.input) then
            activeSliderDrag.updateFromX(input.Position.X)
        end
        return
    end

    if not activeDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if input.UserInputType == Enum.UserInputType.Touch and input ~= activeDrag.input then
        return
    end

    local delta = input.Position - activeDrag.dragStart
    if delta.Magnitude >= 6 and activeDrag.markDragged then
        activeDrag.markDragged()
    end

    local targetX = activeDrag.startPos.X.Offset + delta.X
    local targetY = activeDrag.startPos.Y.Offset + delta.Y
    local viewportSize = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize

    if viewportSize then
        local objectSize = activeDrag.obj.AbsoluteSize
        local margin = 8
        local anchor = activeDrag.obj.AnchorPoint
        local baseX = activeDrag.startPos.X.Scale * viewportSize.X
        local baseY = activeDrag.startPos.Y.Scale * viewportSize.Y
        local minX = margin + objectSize.X * anchor.X - baseX
        local maxX = viewportSize.X - margin - objectSize.X * (1 - anchor.X) - baseX
        local minY = margin + objectSize.Y * anchor.Y - baseY
        local maxY = viewportSize.Y - margin - objectSize.Y * (1 - anchor.Y) - baseY
        targetX = math.clamp(targetX, minX, math.max(minX, maxX))
        targetY = math.clamp(targetY, minY, math.max(minY, maxY))
    end

    activeDrag.obj.Position = UDim2.new(
        activeDrag.startPos.X.Scale, targetX,
        activeDrag.startPos.Y.Scale, targetY
    )
end))

