        sub.TextSize               = 11
        sub.TextXAlignment         = Enum.TextXAlignment.Left
        sub.TextTruncate           = Enum.TextTruncate.AtEnd
    end

    local switchTrack = Instance.new("Frame")
    switchTrack.Name             = "SwitchTrack"
    switchTrack.Parent           = row
    switchTrack.BackgroundColor3 = Theme.SwitchOff
    switchTrack.Size             = UDim2.fromOffset(40, 22)
    switchTrack.Position         = UDim2.new(1, -52, 0.5, -11)
    switchTrack.BorderSizePixel  = 0
    Instance.new("UICorner", switchTrack).CornerRadius = UDim.new(1, 0)

    local switchKnob = Instance.new("Frame")
    switchKnob.Name             = "Knob"
    switchKnob.Parent           = switchTrack
    switchKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    switchKnob.Size             = UDim2.fromOffset(16, 16)
    switchKnob.Position         = UDim2.new(0, 3, 0.5, -8)
    switchKnob.BorderSizePixel  = 0
    Instance.new("UICorner", switchKnob).CornerRadius = UDim.new(1, 0)

    local isOn = false
    local api = { key = text, button = row, isOn = function() return isOn end }
    table.insert(toggleApis, api)
    toggleRegistry[text] = api

    local function animateSwitch(on)
        TweenService:Create(switchTrack, TweenSwitch, {
            BackgroundColor3 = on and Theme.Accent or Theme.SwitchOff,
        }):Play()
        TweenService:Create(switchKnob, TweenSwitch, {
            Position = on and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        }):Play()
        TweenService:Create(accentBar, TweenSwitch, {
            BackgroundColor3 = on and Theme.Accent or Theme.SwitchOff,
        }):Play()
        TweenService:Create(rowStroke, TweenSwitch, {
            Color = on and Theme.Accent or Theme.Stroke,
            Transparency = on and 0.35 or 0.25,
        }):Play()
    end

    onAccentChanged(function()
        if isOn then animateSwitch(true) end
    end)

    function api.setState(on)
        on = not not on
        if isOn == on then return end
        isOn = on
        animateSwitch(on)

        local success, err = pcall(callback, on)
        if not success then
            warn("[Johan Hub] Failed to toggle " .. text .. ": " .. tostring(err))
            isOn = not on
            animateSwitch(isOn)
            pcall(callback, isOn)
            return false
        end
        return true
    end

    if defaultOn then
        isOn = true
        switchTrack.BackgroundColor3 = Theme.Accent
        switchKnob.Position = UDim2.new(1, -19, 0.5, -8)
        accentBar.BackgroundColor3 = Theme.Accent
        rowStroke.Color = Theme.Accent
    end

    table.insert(connections, row.MouseButton1Click:Connect(function()
        api.setState(not isOn)
    end))

    table.insert(connections, row.MouseEnter:Connect(function()
        TweenService:Create(row, TweenFast, { BackgroundColor3 = Theme.BgRowHover }):Play()
    end))

    table.insert(connections, row.MouseLeave:Connect(function()
        TweenService:Create(row, TweenFast, { BackgroundColor3 = Theme.BgRow }):Play()
    end))

    return api
end

