local function computeEntityBoxBounds(entry, char, hrp, hrpPos, dist, lodTier1Dist, cfgBox3D, accentColor, centerScreen, vpSize, now)
    local boxX, boxY, boxWidth, boxHeight
    if dist <= lodTier1Dist or cfgBox3D then
        local halfExtents = getCachedHalfExtents(entry, now, char)
        local minX, minY = math.huge, math.huge
        local maxX, maxY = -math.huge, -math.huge

        for i = 1, 8 do
            local cOffset = OBB_CORNERS[i] * halfExtents
            local worldPt = hrp.CFrame:PointToWorldSpace(cOffset)
            scratchWorldCorners[i] = worldPt
            local sx, sy = FrustumCuller:projectPointClipped(worldPt)
            scratchProjectedCorners[i] = Vector2.new(sx, sy)
            if sx < minX then minX = sx end
            if sy < minY then minY = sy end
            if sx > maxX then maxX = sx end
            if sy > maxY then maxY = sy end
        end

        boxWidth  = math.clamp(maxX - minX, 14, vpSize.X * 0.65)
        boxHeight = math.clamp(maxY - minY, 18, vpSize.Y * 0.85)
        boxX      = math.floor((minX + maxX) * 0.5 - boxWidth * 0.5)
        boxY      = math.floor((minY + maxY) * 0.5 - boxHeight * 0.5)

        if cfgBox3D and FrameScheduler.tier < 3 and dist <= 240 then
            for i = 1, 12 do
                local edge = OBB_EDGES[i]
                local okSeg, ax, ay, bx, by = FrustumCuller:projectClippedSegment(
                    scratchWorldCorners[edge[1]],
                    scratchWorldCorners[edge[2]]
                )
                if okSeg then
                    drawCached2DLine(entry.box3DLines[i], ax, ay, bx, by, accentColor, 1, 0.25)
                else
                    hideCachedLine(entry.box3DLines[i])
                end
            end
        else
            for i = 1, 12 do hideCachedLine(entry.box3DLines[i]) end
        end
    else
        for i = 1, 12 do hideCachedLine(entry.box3DLines[i]) end
        local _, topY = FrustumCuller:projectPointClipped(hrpPos + Vector3.new(0, 2.85, 0))
        local _, botY = FrustumCuller:projectPointClipped(hrpPos - Vector3.new(0, 3.25, 0))
        boxHeight = math.clamp(math.abs(botY - topY), 16, vpSize.Y * 0.85)
        boxWidth  = math.clamp(boxHeight * 0.60, 12, vpSize.X * 0.60)
        boxX      = math.floor(centerScreen.X - boxWidth * 0.5)
        boxY      = math.floor(topY)
    end
    return boxX, boxY, boxWidth, boxHeight
end

local function renderEntitySkeleton(entry, char, hum, dist, lodTier1Dist, accentColor, now)
    if state.espSkeleton and dist <= (lodTier1Dist + 35) then
        local cachedPairs = getStreamingSafeBoneParts(entry, now, char, hum)
        for i = 1, #entry.boneLines do
            local pairParts = cachedPairs[i]
            local boneLine = entry.boneLines[i]
            if pairParts then
                local partA = pairParts[1]
                local partB = pairParts[2]
                if partA and partB and partA.Parent == char and partB.Parent == char then
                    local okSeg, ax, ay, bx, by = FrustumCuller:projectClippedSegment(partA.Position, partB.Position)
                    if okSeg then
                        drawCached2DLine(boneLine, ax, ay, bx, by, accentColor, 1, 0.2)
                    else
                        hideCachedLine(boneLine)
                    end
                else
                    hideCachedLine(boneLine)
                end
            else
                hideCachedLine(boneLine)
            end
        end
    else
        for i = 1, #entry.boneLines do hideCachedLine(entry.boneLines[i]) end
    end
end

local function renderEntityTrajectories(entry, slot, char, cam, hrpPos, rawVel, smoothVel, futureLeadWorld, flatSpeed, dist, accentColor, dt)
    if state.espVelocityVec and flatSpeed > 2.0 and dist <= 320 then
        local okVec, ax, ay, bx, by = FrustumCuller:projectClippedSegment(hrpPos, futureLeadWorld)
        if okVec then
            local conf = entry.interceptConf or 0.8
            local retColor = (conf >= 0.62 and Theme.WaypointCyan) or (conf >= 0.32 and Theme.WarnAmber) or Theme.Danger
            local lineTrans = math.clamp(1.0 - (entry.interceptAlpha or 0.85) * 0.85, 0.10, 0.82)
            drawCached2DLine(entry.velLine, ax, ay, bx, by, retColor, 2, lineTrans)
            local diam = math.floor(math.clamp((entry.interceptRad or 8.0) * 1.35, 8, 38) + 0.5)
            entry.velDot.Position = UDim2.fromOffset(bx, by)
            entry.velDot.Size = UDim2.fromOffset(diam, diam)
            entry.velDot.BackgroundColor3 = retColor
            if entry.velDotStroke then
                entry.velDotStroke.Color = retColor
                entry.velDotStroke.Transparency = math.clamp(1.0 - (entry.interceptAlpha or 0.85), 0.04, 0.85)
            end
            entry.velDot.Visible = true
        else
            hideCachedLine(entry.velLine)
            entry.velDot.Visible = false
        end
    else
        hideCachedLine(entry.velLine)
        entry.velDot.Visible = false
    end

    if state.espParabolicArc and math.abs(rawVel.Y) > 3.5 and dist <= 200 then
        local myChar = getCharacter()
        losRayParams.FilterDescendantsInstances = myChar and { myChar, char, cam } or { char, cam }
        local validCount, impactWorld = computeGroundClampedBallisticArc(
            hrpPos,
            smoothVel,
            Workspace.Gravity,
            losRayParams,
            FrameScheduler:consumeRayToken()
        )
        for seg = 1, 4 do
            if seg < validCount then
                local okArc, ax, ay, bx, by = FrustumCuller:projectClippedSegment(
                    scratchBallisticPts[seg],
                    scratchBallisticPts[seg + 1]
                )
                if okArc then
                    drawCached2DLine(entry.arcLines[seg], ax, ay, bx, by, Theme.WarnAmber, 2, 0.22)
                else
                    hideCachedLine(entry.arcLines[seg])
                end
            else
                hideCachedLine(entry.arcLines[seg])
            end
        end
        if impactWorld then
            local impX, impY, impVis = FrustumCuller:projectPointClipped(impactWorld)
            if impVis then
                entry.landingDot.Position = UDim2.fromOffset(impX, impY)
                entry.landingDot.Visible = true
            else
                entry.landingDot.Visible = false
            end
        else
            entry.landingDot.Visible = false
        end
    else
        for seg = 1, 4 do hideCachedLine(entry.arcLines[seg]) end
        entry.landingDot.Visible = false
    end

    local base = (slot - 1) * ENTITY_STRIDE
    if state.espMotionTrail and dist <= 185 then
        local headIdx = BufferLib.readu8(entitySoABuffer, base + 56)
        local count   = BufferLib.readu8(entitySoABuffer, base + 57)
        local maxSegs = math.min(count - 1, #entry.trailLines)
        for tIdx = 1, #entry.trailLines do
            if tIdx <= maxSegs then
                local idxA = ((headIdx - tIdx) % TRAIL_CAP) + 1
                local idxB = ((headIdx - tIdx - 1) % TRAIL_CAP) + 1
                local offA = base + TRAIL_BASE_OFFSET + ((idxA - 1) * 12)
                local offB = base + TRAIL_BASE_OFFSET + ((idxB - 1) * 12)
                local pA = Vector3.new(
                    BufferLib.readf32(entitySoABuffer, offA),
                    BufferLib.readf32(entitySoABuffer, offA + 4),
                    BufferLib.readf32(entitySoABuffer, offA + 8)
                )
                local pB = Vector3.new(
                    BufferLib.readf32(entitySoABuffer, offB),
                    BufferLib.readf32(entitySoABuffer, offB + 4),
                    BufferLib.readf32(entitySoABuffer, offB + 8)
                )
                local okTr, ax, ay, bx, by = FrustumCuller:projectClippedSegment(pA, pB)
                if okTr then
                    local fade = math.clamp(0.18 + (tIdx / TRAIL_CAP) * 0.75, 0.18, 0.94)
                    drawCached2DLine(entry.trailLines[tIdx], ax, ay, bx, by, accentColor, 2, fade)
                else
                    hideCachedLine(entry.trailLines[tIdx])
                end
            else
                hideCachedLine(entry.trailLines[tIdx])
            end
        end
    else
        for tIdx = 1, #entry.trailLines do hideCachedLine(entry.trailLines[tIdx]) end
    end

    if state.espFootstepRing and FrameScheduler.tier < 3 and flatSpeed > 2.5 and dist <= 125 then
        entry.footPulsePhase = (entry.footPulsePhase + dt * 3.2) % 1
        if FrameScheduler.allowSecondaryThisFrame then
            local ringRadius = 1.2 + entry.footPulsePhase * 3.4
            local ringAlpha  = math.clamp(0.15 + entry.footPulsePhase * 0.78, 0.15, 0.95)
            local footCenter = hrpPos - Vector3.new(0, 2.9, 0)
            for s = 1, 8 do
                local ang = (s - 1) * (math.pi * 2 / 8)
                scratchFootPts[s] = footCenter + Vector3.new(math.cos(ang) * ringRadius, 0, math.sin(ang) * ringRadius)
            end
            for s = 1, 8 do
                local nxt = (s % 8) + 1
                local okFoot, ax, ay, bx, by = FrustumCuller:projectClippedSegment(scratchFootPts[s], scratchFootPts[nxt])
                if okFoot then
                    drawCached2DLine(entry.footstepLines[s], ax, ay, bx, by, accentColor, 1, ringAlpha)
                else
                    hideCachedLine(entry.footstepLines[s])
                end
            end
        end
    else
        for s = 1, 8 do hideCachedLine(entry.footstepLines[s]) end
    end
end

local function renderEntityHeadAndTracers(entry, char, aimSeverity, accentColor, tracerOrigin, centerScreenX, boxBottomY, dist)
    local head = char:FindFirstChild("Head")
    if state.espLookRay and head and head:IsA("BasePart") and dist <= 240 then
        local hx, hy, hVis = FrustumCuller:projectPointClipped(head.Position)
        if hVis then
            entry.headDot.Position = UDim2.fromOffset(hx, hy)
            entry.headDotStroke.Color = accentColor
            entry.headDot.Visible = true
            local lookEndWorld = head.Position + head.CFrame.LookVector * 5.5
            local okRay, ax, ay, bx, by = FrustumCuller:projectClippedSegment(head.Position, lookEndWorld)
            if okRay then
                drawCached2DLine(
                    entry.lookRayLine,
                    ax,
                    ay,
                    bx,
                    by,
                    (aimSeverity == 2 and Theme.Danger) or Theme.WarnAmber,
                    2,
                    0.1
                )
            else
                hideCachedLine(entry.lookRayLine)
            end
        else
            entry.headDot.Visible = false
            hideCachedLine(entry.lookRayLine)
        end
    else
        entry.headDot.Visible = false
        hideCachedLine(entry.lookRayLine)
    end

    if state.espTracers then
        drawCached2DLine(entry.tracerLine, tracerOrigin.X, tracerOrigin.Y, centerScreenX, boxBottomY, accentColor, 1, 0.35)
    else
        hideCachedLine(entry.tracerLine)
    end
end

stepProESP = function(dt)
    local cam = Workspace.CurrentCamera
    if not cam then return end

    FrameScheduler:beginFrame(dt)
    FrustumCuller:updateFromCamera(cam)
    resetSapLabels()

    local now = os.clock()
    local myRoot = getRootPart()
    local originPos = myRoot and myRoot.Position or cam.CFrame.Position
    local vpSize = cam.ViewportSize

    stepWaypointsESP(cam, originPos)
    stepWorldObjectsESP(cam, originPos)

    if not state.espEnabled then
        solveAndCommitSapLabels(vpSize.Y)
        return
    end

    local maxDist      = state.espMaxDistance or 600
    local lodTier1Dist = FrameScheduler.lodTier1Dist
    local screenCenter = Vector2.new(vpSize.X * 0.5, vpSize.Y * 0.5)
    local tracerOrigin = Vector2.new(vpSize.X * 0.5, vpSize.Y - 18)

    PiPWidgetManager:syncVisibility("MiniRadar", state.espMiniRadar)
    local camLook = cam.CFrame.LookVector
    local camFlatForward = Vector3.new(camLook.X, 0, camLook.Z)
    camFlatForward = (camFlatForward.Magnitude < 1e-3) and Vector3.new(0, 0, -1) or camFlatForward.Unit
    local camFlatRight = Vector3.new(-camFlatForward.Z, 0, camFlatForward.X)

    local bestFocusPlayer, bestFocusChar, bestFocusHum, bestFocusHrp = nil, nil, nil, nil
    local bestFocusDist, bestFocusTool, bestFocusColor = math.huge, nil, Theme.Accent
    local bestCrosshairScore = 220
    local closestEnemyDist = math.huge
    local closestEnemyArmed = false
    table.clear(scratchAimingNames)
    local maxAimSeverity = 0
    local activeHighlightCount = 0

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hrp = getCharacterRootSafe(char)
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if char and hrp and hum and hum.Health > 0 and not isSameTeam(player) then
                local hrpPos = hrp.Position
                local dist = (hrpPos - originPos).Magnitude
                local heldTool = getEquippedToolName(char)
                if dist < closestEnemyDist then
                    closestEnemyDist = dist
                    closestEnemyArmed = (heldTool ~= nil)
                end

                if dist <= maxDist then
                    local entry = getOrCreateEspEntry(player)
                    local slot  = entry.slot
                    local toolName = state.espToolTag and heldTool or nil
                    local isVisible = (dist <= 300) and getCachedVisibility(entry, now, cam, char, hrp) or false
                    local aimSeverity, aimDirTag = evaluateAimConeSeverity(char, hrp, originPos, cam.CFrame, dist, isVisible)
                    if aimSeverity > 0 then
                        if aimSeverity > maxAimSeverity then maxAimSeverity = aimSeverity end
                        local pName = player.DisplayName or player.Name
                        table.insert(scratchAimingNames, aimDirTag and (pName .. " [" .. aimDirTag .. "]") or pName)
                    end
                    local accentColor = getPlayerEspColor(player, toolName, dist, isVisible, aimSeverity)

                    local rawVel = hrp.AssemblyLinearVelocity
                    local myVel = myRoot and myRoot.AssemblyLinearVelocity or Vector3.zero
                    local futureLeadWorld, smoothVel, eBar, agility, aperiodicity, behLabel, jukeOnset, muCTRV, sStar, tStar, conf, retRad, retAlpha, regime = stepEntityKinematics(
                        slot, dt, now, hrpPos, rawVel, hum.WalkSpeed, 0.55, originPos, myVel, entry.sWarmPrev
                    )
                    entry.smoothVel       = smoothVel
                    entry.immEBar         = eBar
                    entry.immAgility      = agility
                    entry.immAperiodic    = aperiodicity
                    entry.immBehLabel     = behLabel
                    entry.immJukeOnset    = jukeOnset
                    entry.immMuCTRV       = muCTRV
                    entry.sWarmPrev       = sStar
                    entry.interceptTStar  = tStar
                    entry.interceptConf   = conf
                    entry.interceptRad    = retRad
                    entry.interceptAlpha  = retAlpha
                    entry.interceptRegime = regime
                    entry.lastTrailAt = pushEntityTrailSample(slot, now, hrpPos, entry.lastTrailAt)

                    if state.espMiniRadar then
                        local offset = hrpPos - originPos
                        local scaled = Vector2.new(offset:Dot(camFlatRight), -offset:Dot(camFlatForward)) / 220
                        if scaled.Magnitude > 1 then scaled = scaled.Unit end
                        entry.radarBlip.Position = UDim2.new(0.5, math.floor(scaled.X * 50), 0.5, math.floor(scaled.Y * 50))
                        entry.radarBlip.BackgroundColor3 = accentColor
                        entry.radarBlip.Visible = true
                    else
                        entry.radarBlip.Visible = false
                    end

                    if state.espChams and dist <= 400 and activeHighlightCount < 28 then
                        activeHighlightCount = activeHighlightCount + 1
                        if entry.highlight.Parent ~= highlightContainer then
                            entry.highlight.Parent = highlightContainer
                        end
                        if entry.highlight.Adornee ~= char then
                            entry.highlight.Adornee = char
                        end
                        entry.highlight.FillColor = accentColor
                        entry.highlight.OutlineColor = accentColor
                        entry.highlight.Enabled = true
                    else
                        if entry.highlight.Enabled then
                            entry.highlight.Enabled = false
                            entry.highlight.Adornee = nil
                        end
                    end

                    local inFrustum = FrustumCuller:testSphere(hrpPos, 4.8, maxDist)
                    local centerScreen, onScreen = Vector3.zero, false
                    if inFrustum then
                        centerScreen, onScreen = cam:WorldToViewportPoint(hrpPos)
                    end

                    local safeHealth, safeMaxHp = stepEntityHealthAndPopups(
                        entry,
                        now,
                        hum,
                        onScreen and centerScreen.Z > 1,
                        centerScreen.X,
                        centerScreen.Y
                    )

                    if inFrustum and onScreen and centerScreen.Z > 0.5 then
                        if entry.arrowFrame.Visible then entry.arrowFrame.Visible = false end

                        local crosshairDist = (Vector2.new(centerScreen.X, centerScreen.Y) - screenCenter).Magnitude
                        if lockedTargetPlayer == player or (not lockedTargetPlayer and crosshairDist < bestCrosshairScore) then
                            if lockedTargetPlayer ~= player then bestCrosshairScore = crosshairDist end
                            bestFocusPlayer, bestFocusChar, bestFocusHum, bestFocusHrp = player, char, hum, hrp
                            bestFocusDist, bestFocusTool, bestFocusColor = dist, heldTool, accentColor
                        end

                        local boxX, boxY, boxWidth, boxHeight = computeEntityBoxBounds(
                            entry, char, hrp, hrpPos, dist, lodTier1Dist, state.espBox3D, accentColor, centerScreen, vpSize, now
                        )

                        local base = (slot - 1) * ENTITY_STRIDE
                        if math.abs(boxX - BufferLib.readf32(entitySoABuffer, base + 300)) >= 0.5
                        or math.abs(boxY - BufferLib.readf32(entitySoABuffer, base + 304)) >= 0.5 then
                            BufferLib.writef32(entitySoABuffer, base + 300, boxX)
                            BufferLib.writef32(entitySoABuffer, base + 304, boxY)
                            entry.rootFrame.Position = UDim2.fromOffset(boxX, boxY)
                        end
                        if math.abs(boxWidth - BufferLib.readf32(entitySoABuffer, base + 308)) >= 0.5
                        or math.abs(boxHeight - BufferLib.readf32(entitySoABuffer, base + 312)) >= 0.5 then
                            BufferLib.writef32(entitySoABuffer, base + 308, boxWidth)
                            BufferLib.writef32(entitySoABuffer, base + 312, boxHeight)
                            entry.rootFrame.Size = UDim2.fromOffset(math.floor(boxWidth), math.floor(boxHeight))
                        end
                        if not entry.rootFrame.Visible then entry.rootFrame.Visible = true end

                        local showBox = state.espCornerBox and (dist <= 380)
                        entry.boxFill.Visible = showBox
                        entry.boxFill.BackgroundColor3 = accentColor
                        entry.hpBarBg.Visible = showBox
                        for i = 1, #entry.corners do
                            local c = entry.corners[i]
                            c.Visible = showBox
                            c.BackgroundColor3 = accentColor
                        end

                        local targetRatio = math.clamp(safeHealth / math.max(1, safeMaxHp), 0, 1)
                        entry.smoothHp = entry.smoothHp + (targetRatio - entry.smoothHp) * math.clamp(dt * 14, 0.1, 1)
                        local hpColor = getQuantizedHpColor(entry.smoothHp)
                        entry.hpBarFill.Size = UDim2.fromScale(1, entry.smoothHp)
                        entry.hpBarFill.BackgroundColor3 = hpColor

                        if showBox and targetRatio < 0.98 and boxHeight >= 28 then
                            entry.hpText.Visible = true
                            entry.hpText.Text = tostring(math.ceil(safeHealth))
                            entry.hpText.TextColor3 = hpColor
                            entry.hpText.Position = UDim2.new(0, -4, 1 - entry.smoothHp, 0)
                        else
                            entry.hpText.Visible = false
                        end

                        local displayStr = player.DisplayName ~= player.Name
                            and string.format("%s (@%s)", player.DisplayName, player.Name)
                            or player.Name
                        local fullNameStr = (aimSeverity == 2 and ("[LOCK] " .. displayStr))
                            or (aimSeverity == 1 and ("[AIM] " .. displayStr))
                            or displayStr
                        if entry.lastNameStr ~= fullNameStr then
                            entry.lastNameStr = fullNameStr
                            entry.nameTag.Text = fullNameStr
                        end
                        entry.nameTag.TextColor3 = (aimSeverity == 2 and Theme.Danger)
                            or (aimSeverity == 1 and Theme.WarnAmber)
                            or Theme.TextPrimary

                        local flatSpeed = math.sqrt(smoothVel.X * smoothVel.X + smoothVel.Z * smoothVel.Z)
                        local actionBadge = (dist <= 220) and classifyTargetActionState(entry, now, char, hum, flatSpeed) or nil
                        local immTag = ""
                        if entry.immJukeOnset then
                            immTag = "[JUKE!] "
                        elseif entry.immBehLabel == "ERRATIC" or entry.immBehLabel == "PERIODIC" or entry.immBehLabel == "AGILE" then
                            immTag = string.format("[%s %d%%] ", entry.immBehLabel, math.floor((entry.immEBar or 0) * 100 + 0.5))
                        end
                        local statePrefix = (actionBadge and actionBadge ~= "IDLE" and not string.find(actionBadge, "MOVE", 1, true))
                            and ("[" .. actionBadge .. "] ") or ""
                        local visTag = state.espWallCheck and (isVisible and "VIS " or "WALL ") or ""
                        local toolPrefix = toolName and ("[" .. toolName .. "] ") or ""
                        local newBottomStr = string.format("%s%s%s%s%dm", immTag, statePrefix, visTag, toolPrefix, math.floor(dist + 0.5))
                        if entry.lastBottomStr ~= newBottomStr then
                            entry.lastBottomStr = newBottomStr
                            entry.bottomTag.Text = newBottomStr
                        end
                        entry.bottomTag.TextColor3 = toolName and Theme.WarnAmber or accentColor

                        renderEntitySkeleton(entry, char, hum, dist, lodTier1Dist, accentColor, now)
                        renderEntityTrajectories(entry, slot, char, cam, hrpPos, rawVel, smoothVel, futureLeadWorld, flatSpeed, dist, accentColor, dt)
                        renderEntityHeadAndTracers(entry, char, aimSeverity, accentColor, tracerOrigin, centerScreen.X, boxY + boxHeight, dist)
                    else
                        entry.rootFrame.Visible = false
                        hideCachedLine(entry.tracerLine)
                        hideCachedLine(entry.lookRayLine)
                        hideCachedLine(entry.velLine)
                        entry.velDot.Visible = false
                        entry.headDot.Visible = false
                        entry.landingDot.Visible = false
                        for i = 1, #entry.boneLines do hideCachedLine(entry.boneLines[i]) end
                        for i = 1, #entry.box3DLines do hideCachedLine(entry.box3DLines[i]) end
                        for i = 1, #entry.footstepLines do hideCachedLine(entry.footstepLines[i]) end
                        for i = 1, #entry.arcLines do hideCachedLine(entry.arcLines[i]) end
                        for i = 1, #entry.trailLines do hideCachedLine(entry.trailLines[i]) end

                        if state.espRadar and dist <= math.min(maxDist, 380) then
                            local rel = cam.CFrame:PointToObjectSpace(hrpPos)
                            local angle = math.atan2(rel.X, -rel.Z)
                            local dir = Vector2.new(math.sin(angle), -math.cos(angle))
                            local arrowPos = screenCenter + dir * (math.min(vpSize.X, vpSize.Y) * 0.34)

                            entry.arrowFrame.Position = UDim2.fromOffset(arrowPos.X, arrowPos.Y)
                            entry.pointerHolder.Rotation = math.deg(angle)
                            entry.pointerDiamond.BackgroundColor3 = accentColor
                            entry.arrowStroke.Color = accentColor
                            entry.arrowDist.Text = string.format("%dm", math.floor(dist + 0.5))
                            entry.arrowFrame.Visible = true
                        else
                            entry.arrowFrame.Visible = false
                        end
                    end
                else
                    hideEspEntryVisuals(espEntries[player])
                end
            else
                hideEspEntryVisuals(espEntries[player])
            end
        end
    end

    updateSelfProximityRing(cam, myRoot, closestEnemyDist, closestEnemyArmed)
    solveAndCommitSapLabels(vpSize.Y)

    if state.espAimAlert and #scratchAimingNames > 0 then
        aimAlertBanner.Visible = true
        local col = (maxAimSeverity == 2) and Theme.Danger or Theme.WarnAmber
        aimAlertStroke.Color = col
        aimAlertText.TextColor3 = col
        local prefix = (maxAimSeverity == 2) and "[ ! ]  CRITICAL LOCK ON YOU: " or "[ ! ]  AIMING NEAR YOU: "
        aimAlertText.Text = prefix .. table.concat(scratchAimingNames, ", ")
    else
        aimAlertBanner.Visible = false
    end

    currentFocusedTarget = lockedTargetPlayer or bestFocusPlayer
    if lockedTargetPlayer and lockedTargetPlayer.Character then
        local lChar = lockedTargetPlayer.Character
        local lHrp  = lChar:FindFirstChild("HumanoidRootPart") or lChar.PrimaryPart
        local lHum  = lChar:FindFirstChildOfClass("Humanoid")
        if lHrp and lHum and lHum.Health > 0 then
            local lDist = (lHrp.Position - originPos).Magnitude
            updateTargetInspectorHUD(lockedTargetPlayer, lChar, lHum, lHrp, lDist, getEquippedToolName(lChar), Theme.WarnAmber, now)
        else
            lockedTargetPlayer = nil
            hudLockBtn.Text = "LOCK"
            hudLockBtn.TextColor3 = Theme.TextPrimary
            hudLockStroke.Color = Theme.Stroke
            updateTargetInspectorHUD(bestFocusPlayer, bestFocusChar, bestFocusHum, bestFocusHrp, bestFocusDist, bestFocusTool, bestFocusColor, now)
        end
    else
        updateTargetInspectorHUD(bestFocusPlayer, bestFocusChar, bestFocusHum, bestFocusHrp, bestFocusDist, bestFocusTool, bestFocusColor, now)
    end

    if state.spectateTarget and cam.CameraType == Enum.CameraType.Custom then
        local targetToWatch = lockedTargetPlayer or currentFocusedTarget
        local tChar = targetToWatch and targetToWatch.Character
        local tHum  = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if tHum and tHum.Health > 0 then
            if cam.CameraSubject ~= tHum then
                cam.CameraSubject = tHum
            end
        else
            local myHum = getHumanoid()
            if myHum and cam.CameraSubject ~= myHum then
                cam.CameraSubject = myHum
            end
        end
    end
end

