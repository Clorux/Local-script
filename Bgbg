-- [SECTION 10] HTTP layer (token bucket, 429 backoff, timeout)
--============================================================================--

-- getRequestFn: resolves the executor HTTP function by reading globals DIRECTLY (never rawget(_G, ...)), in this priority order (BUG-3).
local function getRequestFn()
    local r = request
    if type(r) == "function" then
        return r
    end
    local hr = http_request
    if type(hr) == "function" then
        return hr
    end
    local s = syn
    if type(s) == "table" and type(s.request) == "function" then
        return s.request
    end
    local f = fluxus
    if type(f) == "table" and type(f.request) == "function" then
        return f.request
    end
    local h = http
    if type(h) == "table" and type(h.request) == "function" then
        return h.request
    end
    return nil
end

-- httpEnabled: true when any executor HTTP function exists; when false the module is silently local-only (test 5).
local function httpEnabled()
    return getRequestFn() ~= nil
end

-- backendConfigured: true only when BACKEND_URL is set and is NOT the placeholder; plain find with `true` (Lua pattern gotcha, BUG-7).
local function backendConfigured()
    if type(BACKEND_URL) ~= "string" or #BACKEND_URL == 0 then
        return false
    end
    if BACKEND_URL:find("your-worker", 1, true) then
        return false
    end
    return true
end

-- httpRequest: single low-level request entry; attaches Authorization ONLY when BACKEND_API_KEY is non-nil (BUG-6); returns response table or nil.
local function httpRequest(method, url, body)
    local req = getRequestFn()
    if not req then
        return nil
    end
    local headers = { ["Content-Type"] = "application/json" }
    if BACKEND_API_KEY ~= nil then
        headers["Authorization"] = "Bearer " .. tostring(BACKEND_API_KEY)
    end
    local args = { Url = url, Method = method, Headers = headers }
    if body ~= nil then
        args.Body = body
    end
    local ok, resp = pcall(req, args)
    if not ok or type(resp) ~= "table" then
        return nil
    end
    return resp
end

-- httpRequestTimed: soft timeout wrapper — the request runs on a worker thread and is abandoned after HTTP_TIMEOUT_SECONDS (monotonic tick).
local function httpRequestTimed(method, url, body)
    local done = false
    local result = nil
    task.spawn(function()
        result = httpRequest(method, url, body)
        done = true
    end)
    local deadline = tick() + HTTP_TIMEOUT_SECONDS
    while not done and tick() < deadline do
        task.wait(0.05)
    end
    if not done then
        return nil   -- timed out; the worker thread is abandoned harmlessly
    end
    return result
end

-- httpJson: JSON convenience layer returning (statusCode, decodedBody, rawResponse); nil status means transport failure.
local function httpJson(method, url, payload)
    local body = nil
    if payload ~= nil then
        local ok, enc = pcall(function()
            return HttpService:JSONEncode(payload)
        end)
        if not ok then
            return nil
        end
        body = enc
    end
    local resp = httpRequestTimed(method, url, body)
    if not resp then
        return nil
    end
    local status = tonumber(resp.StatusCode or resp.Status or resp.status_code) or 0
    local decoded = nil
    if type(resp.Body) == "string" and #resp.Body > 0 then
        pcall(function()
            decoded = HttpService:JSONDecode(resp.Body)
        end)
    end
    return status, decoded, resp
end

-- Token bucket state (used by Discord notifications): capacity 2, refill 1 token per 30 seconds (spec §2.5).
local bucketTokens = DISCORD_BUCKET_CAPACITY
local bucketLastRefill = tick()

-- bucketRefill: adds tokens earned since the last refill based on monotonic elapsed time; no environment assumptions.
local function bucketRefill()
    local now = tick()
    local elapsed = now - bucketLastRefill
    if elapsed >= DISCORD_REFILL_SECONDS then
        local earned = math.floor(elapsed / DISCORD_REFILL_SECONDS)
        bucketTokens = math.min(DISCORD_BUCKET_CAPACITY, bucketTokens + earned)
        bucketLastRefill = bucketLastRefill + earned * DISCORD_REFILL_SECONDS
    end
end

-- bucketTake: consumes one token if available after refill; returns true/false; no environment assumptions.
local function bucketTake()
    bucketRefill()
    if bucketTokens >= 1 then
        bucketTokens = bucketTokens - 1
        return true
    end
    return false
end

-- Discord 429 backoff state: monotonic timestamp until which Discord sends are suppressed (spec §2.5).
local discordBackoffUntil = 0

-- readRetryAfter: extracts the Retry-After header (any header-key casing) from a 429 response; returns seconds or nil (test 13).
local function readRetryAfter(resp)
    if type(resp) ~= "table" then
        return nil
    end
    local h = resp.Headers or resp.headers
    if type(h) ~= "table" then
        return nil
    end
    for k, v in pairs(h) do
        if tostring(k):lower() == "retry-after" then
            return tonumber(v)
        end
    end
    return nil
end

