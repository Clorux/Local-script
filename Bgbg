-- [SECTION 7] Local storage (save / load / verify / rollback)
--============================================================================--

-- b64Encode: pcall'd HttpService:Base64Encode; returns nil on failure (HttpService is always present, but never crash).
local function b64Encode(s)
    local ok, out = pcall(function()
        return HttpService:Base64Encode(s)
    end)
    if ok and type(out) == "string" then
        return out
    end
    return nil
end

-- b64Decode: pcall'd HttpService:Base64Decode; returns nil on failure or malformed input.
local function b64Decode(s)
    local ok, out = pcall(function()
        return HttpService:Base64Decode(s)
    end)
    if ok and type(out) == "string" then
        return out
    end
    return nil
end

-- cfgPaths: returns the .dat and .bak paths for a userKey; userKey doubles as the local file name (spec §2.1).
local function cfgPaths(userKey)
    local base = ASTER_IDENTITY_DIR .. "/cfg_" .. tostring(userKey)
    return base .. ".dat", base .. ".bak"
end

-- FIX: invariant comment added above encodeEnvelope (documented in review).
-- INVARIANT: every value under data.values must be JSON-safe (gated by
-- asterConfigSet / legacyImportOnce); non-JSON-safe values canonicalize to
-- null and would be dropped by JSONDecode on readback, breaking the checksum.
-- Do not write to liveConfig.values directly; always go through asterConfigSet.

-- encodeEnvelope: wraps data as {sum=SHA256(canonicalEncode(data)), data=...}; checksum NEVER comes from raw JSONEncode (BUG-9).
local function encodeEnvelope(data)
    local envelope = {
        sum  = hash(canonicalEncode(data)),
        data = data,
    }
    local plain = canonicalEncode(envelope)
    local b64 = b64Encode(asterXorObfuscate(plain, ASTER_CFG_OBFUSCATE_KEY))
    if not b64 then
        return nil
    end
    return FILE_MAGIC .. b64
end

-- decodeBlob: validates magic, Base64-decodes, de-XORs, JSON-decodes, and checksum-verifies; returns data or (nil, reason).
local function decodeBlob(text)
    if type(text) ~= "string" or text:sub(1, #FILE_MAGIC) ~= FILE_MAGIC then
        return nil, "bad magic"
    end
    local xored = b64Decode(text:sub(#FILE_MAGIC + 1))
    if not xored then
        return nil, "base64 decode failed"
    end
    local plain = asterXorObfuscate(xored, ASTER_CFG_OBFUSCATE_KEY)
    local ok, envelope = pcall(function()
        return HttpService:JSONDecode(plain)
    end)
    if not ok or type(envelope) ~= "table" or type(envelope.data) ~= "table" or type(envelope.sum) ~= "string" then
        return nil, "envelope decode failed"
    end
    if hash(canonicalEncode(envelope.data)) ~= envelope.sum:lower() then
        return nil, "checksum mismatch"
    end
    return envelope.data
end

-- saveConfigBlob: full save pipeline — makefolder, clean-only backup, write, hide, read-back verify, rollback (spec §2.2, BUG-13).
-- Every environment call is pcall'd; returns true, or (false, reason).
local function saveConfigBlob(userKey, data)
    local dat, bak = cfgPaths(userKey)
    -- Step 1: recreate folder before every write; it may have been wiped mid-session (test 14).
    ensureFolder(ASTER_IDENTITY_DIR)
    -- Step 2: back up the current .dat ONLY if it decodes cleanly (BUG-13).
    local current = readTextFile(dat)
    if current and decodeBlob(current) ~= nil then
        writeTextFile(bak, current)
    end
    -- Step 3: write the new blob.
    local blob = encodeEnvelope(data)
    if not blob then
        return false, "encode failed"
    end
    if not writeTextFile(dat, blob) then
        return false, "write unavailable"   -- zero file I/O: stay silent, in-memory only
    end
    -- Step 4: hide the new .dat if the executor supports it.
    local h = sethiddenfile
    if type(h) == "function" then
        pcall(h, dat, true)
    end
    -- Step 5: read back, decode, verify; on failure restore .bak, or delete the corrupt .dat on first save (BUG-13).
    local written = readTextFile(dat)
    if written and decodeBlob(written) ~= nil then
        return true
    end
    local bakRaw = readTextFile(bak)
    if bakRaw and decodeBlob(bakRaw) ~= nil then
        writeTextFile(dat, bakRaw)
        return false, "verify failed, restored backup"
    end
    deleteTextFile(dat)
    return false, "verify failed, no backup"
end

-- loadConfigBlob: loads and verifies .dat; on corruption falls back to a valid .bak (promoting it to .dat);
-- if both are corrupt both are deleted and defaults apply (tests 2 and 3). Returns data table or nil.
local function loadConfigBlob(userKey)
    local dat, bak = cfgPaths(userKey)
    local raw = readTextFile(dat)
    if raw then
        local data = decodeBlob(raw)
        if data then
            return data
        end
        -- .dat is corrupt: try to recover from .bak.
        local bakRaw = readTextFile(bak)
        if bakRaw then
            local bakData = decodeBlob(bakRaw)
            if bakData then
                writeTextFile(dat, bakRaw)   -- promote .bak to .dat (test 2)
                local h = sethiddenfile
                if type(h) == "function" then
                    pcall(h, dat, true)
                end
                return bakData
            end
            deleteTextFile(bak)              -- both corrupt: delete both (test 3)
        end
        deleteTextFile(dat)
        return nil
    end
    -- No .dat: accept a lone valid .bak and promote it.
    local bakRaw = readTextFile(bak)
    if bakRaw then
        local bakData = decodeBlob(bakRaw)
        if bakData then
            writeTextFile(dat, bakRaw)
            return bakData
        end
        deleteTextFile(bak)
    end
    return nil
end

