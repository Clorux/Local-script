-- Private obfuscation key for config blobs; deliberately NOT premium.txt's PACKET_IDS_CACHE_OBFUSCATE_KEY (BUG-19).
local ASTER_CFG_OBFUSCATE_KEY = "A$t3rId3nt1tyCfg_v4"

-- asterXorObfuscate: repeating-key XOR over a byte string (private copy;
-- deliberately NOT premium.txt's xorObfuscateString); no environment assumptions.
local function asterXorObfuscate(text, key)
    key = key or ASTER_CFG_OBFUSCATE_KEY
    local klen = #key
    local out = {}
    for i = 1, #text do
        local kb = string.byte(key, ((i - 1) % klen) + 1)
        out[i] = string.char(bit32.bxor(string.byte(text, i), kb))
    end
    return table.concat(out)
end

