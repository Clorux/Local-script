-- [SECTION 8] Migration chain + one-time legacy import
--============================================================================--

-- Forward declaration; assigned in [SECTION 9] before any runtime call.
local isJsonSafe

-- migrationSteps: ordered schema upgrades keyed by the version they upgrade FROM; each returns the upgraded table.
local migrationSteps = {
    -- v1 -> v2: introduce the wrapped-values map; move bare non-reserved top-level keys into it stamped t = 0.
    [1] = function(raw)
        raw.values = type(raw.values) == "table" and raw.values or {}
        for k, v in pairs(raw) do
            if k ~= "version" and k ~= "values" and k ~= "lastDevice" and k ~= "deviceHistory" then
                if raw.values[k] == nil then
                    raw.values[k] = { v = v, t = 0 }
                end
                raw[k] = nil
            end
        end
        raw.version = 2
        return raw
    end,
    -- v2 -> v3: introduce device tracking containers.
    [2] = function(raw)
        if type(raw.deviceHistory) ~= "table" then
            raw.deviceHistory = {}
        end
        if type(raw.lastDevice) ~= "table" then
            raw.lastDevice = nil
        end
        raw.version = 3
        return raw
    end,
    -- v3 -> v4: introduce the createdAt marker; current schema.
    [3] = function(raw)
        if tonumber(raw.createdAt) == nil then
            raw.createdAt = os.time()
        end
        raw.version = 4
        return raw
    end,
}

-- migrateConfig: runs the migration chain to CONFIG_VERSION; warns (never hard-fails) if the chain is incomplete (BUG-20, test 16).
local function migrateConfig(raw)
    if type(raw) ~= "table" then
        raw = {}
    end
    raw.version = tonumber(raw.version) or 1
    local guard = 0
    while raw.version < CONFIG_VERSION and guard < 16 do
        local step = migrationSteps[raw.version]
        if type(step) ~= "function" then
            break
        end
        local ok, out = pcall(step, raw)
        if not ok or type(out) ~= "table" then
            break
        end
        raw = out
        guard = guard + 1
    end
    if raw.version ~= CONFIG_VERSION then
        warn(MODULE_TAG .. " Config migration chain incomplete, schema may be stale")
    end
    return raw
end

-- legacyImportOnce: imports EXACTLY ONE legacy profile (ASTER_LEGACY_PROFILE) from ASTER/Configs/*.json, exactly once (BUG-10, test 17).
-- The marker file is written BEFORE any work so a crash mid-import cannot retrigger it; imported values are stamped t = 0.
local function legacyImportOnce(data)
    if ASTER_LEGACY_PROFILE == nil then
        return data   -- legacy import disabled entirely
    end
    if readTextFile(LEGACY_MARKER_PATH) ~= nil then
        return data   -- already imported in a previous session
    end
    ensureFolder(ASTER_IDENTITY_DIR)
    writeTextFile(LEGACY_MARKER_PATH, "imported_at=" .. tostring(os.time()))   -- marker FIRST (crash-safe)
    local path = ASTER_LEGACY_DIR .. "/" .. tostring(ASTER_LEGACY_PROFILE) .. ".json"
    local raw = readTextFile(path)
    if not raw then
        return data
    end
    local ok, legacy = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not ok or type(legacy) ~= "table" then
        return data
    end
    data.values = type(data.values) == "table" and data.values or {}
    for k, v in pairs(legacy) do
        -- t = 0: imported legacy values NEVER outrank real edits in a merge.
        if data.values[k] == nil and (type(isJsonSafe) ~= "function" or isJsonSafe(v)) then
            data.values[k] = { v = v, t = 0 }
        end
    end
    return data
end

--============================================================================--
-- [SECTION 9] Per-key merge + tolerant accessors + asterConfigSet
--============================================================================--

-- TODO: tombstones — key deletions currently resurrect through LWW merge; v1 does not implement tombstones (BUG-17).

-- Forward declaration; assigned in [SECTION 11] before any runtime call.
local markDirty

-- Live in-memory config state (values/version/lastDevice/deviceHistory); survives even with zero file I/O.
local liveConfig = nil

-- entryT: tolerant timestamp accessor — wrapped entries yield their t, anything else yields 0 (BUG-11, test 20).
local function entryT(e)
    return type(e) == "table" and tonumber(e.t) or 0
end

-- FIX: entryV now uses an explicit nil check instead of the `and/or` idiom.
-- Lua short-circuit treats a stored boolean `false` as falsy, so
-- `type(e) == "table" and e.v or e` incorrectly returned the whole wrapper
-- table for entries like {v = false, t = 100}. That broke asterConfigGet
-- (returned a truthy table instead of false) and mergeConfigs (wrote nested
-- envelopes). Fixed with an explicit `e.v ~= nil` check.

-- entryV: tolerant value accessor — wrapped entries yield their v, bare values yield themselves (BUG-11, test 20).
-- Uses an explicit nil check instead of `and/or`: Lua short-circuit treats a stored boolean `false` as falsy
-- and would wrongly return the whole wrapper table for entries like {v = false, t = 100}.
local function entryV(e)
    if type(e) == "table" and e.v ~= nil then
        return e.v
    end
    return e
end

-- isJsonSafe: true when value is a string/number/boolean or a table recursively composed of only those (BUG-11); cycle-safe via depth cap.
isJsonSafe = function(v, depth)
    depth = depth or 0
    if depth > 32 then
        return false
    end
    local t = type(v)
    if t == "string" or t == "boolean" then
        return true
    end
    if t == "number" then
        return v == v and v ~= math.huge and v ~= -math.huge
    end
    if t == "table" then
        for k, val in pairs(v) do
            local kt = type(k)
            if kt ~= "string" and kt ~= "number" then
                return false
            end
            if not isJsonSafe(val, depth + 1) then
                return false
            end
        end
        return true
    end
    return false
end

-- mergeHistory: unions two deviceHistory arrays deduped by deviceKey, keeping the max seenAt per device (BUG-15, test 19).
local function mergeHistory(a, b)
    local byKey, order = {}, {}
    local function absorb(list)
        if type(list) ~= "table" then
            return
        end
        for _, e in pairs(list) do
            if type(e) == "table" and type(e.deviceKey) == "string" then
                local seenAt = tonumber(e.seenAt) or 0
                if byKey[e.deviceKey] then
                    if seenAt > byKey[e.deviceKey].seenAt then
                        byKey[e.deviceKey].seenAt = seenAt
                    end
                else
                    byKey[e.deviceKey] = { deviceKey = e.deviceKey, executor = e.executor, seenAt = seenAt }
                    order[#order + 1] = e.deviceKey
                end
            end
        end
    end
    absorb(a)
    absorb(b)
    local out = {}
    for i = 1, #order do
        out[i] = byKey[order[i]]
    end
    return out
end

-- mergeConfigs: per-key last-writer-wins merge by max t over the values map (tests 11, 12); bare values are tolerated via entryT/entryV (test 20).
local function mergeConfigs(localCfg, remoteCfg)
    if type(localCfg) ~= "table" then
        localCfg = {}
    end
    if type(remoteCfg) ~= "table" then
        return localCfg
    end
    localCfg.values = type(localCfg.values) == "table" and localCfg.values or {}
    -- Merge the wrapped values map; higher t wins, ties keep the local entry.
    if type(remoteCfg.values) == "table" then
        for k, re in pairs(remoteCfg.values) do
            local le = localCfg.values[k]
            if le == nil or entryT(re) > entryT(le) then
                localCfg.values[k] = { v = entryV(re), t = entryT(re) }
            end
        end
    end
    -- Tolerate a flat remote map: non-reserved top-level keys are treated as value entries (bare numbers included; test 20).
    for k, re in pairs(remoteCfg) do
        if k ~= "values" and k ~= "version" and k ~= "lastDevice" and k ~= "deviceHistory" and k ~= "createdAt" then
            local le = localCfg.values[k]
            if le == nil or entryT(re) > entryT(le) then
                localCfg.values[k] = { v = entryV(re), t = entryT(re) }
            end
        end
    end
    -- Schema version: keep the higher one.
    if (tonumber(remoteCfg.version) or 0) > (tonumber(localCfg.version) or 0) then
        localCfg.version = tonumber(remoteCfg.version)
    end
    -- Device history: union deduped by deviceKey (BUG-15).
    localCfg.deviceHistory = mergeHistory(localCfg.deviceHistory, remoteCfg.deviceHistory)
    -- lastDevice is local-session metadata; adopt remote's only if we have none.
    if type(localCfg.lastDevice) ~= "table" and type(remoteCfg.lastDevice) == "table" then
        localCfg.lastDevice = remoteCfg.lastDevice
    end
    return localCfg
end

-- asterConfigSet: validates JSON-safety, wraps as {v=value, t=os.time()}, writes to the live config, and marks the debounce dirty (BUG-11).
local function asterConfigSet(key, value)
    if type(key) ~= "string" or #key == 0 then
        return false, "bad key"
    end
    if not isJsonSafe(value) then
        return false, "value is not JSON-safe"
    end
    if type(liveConfig) ~= "table" then
        return false, "config not initialized"
    end
    liveConfig.values = type(liveConfig.values) == "table" and liveConfig.values or {}
    liveConfig.values[key] = { v = value, t = os.time() }
    if type(markDirty) == "function" then
        markDirty()
    end
    return true
end

-- asterConfigGet: tolerant unwrapped read from the live config; returns default when the key or config is absent.
local function asterConfigGet(key, default)
    if type(liveConfig) ~= "table" or type(liveConfig.values) ~= "table" then
        return default
    end
    local e = liveConfig.values[key]
    if e == nil then
        return default
    end
    return entryV(e)
end

