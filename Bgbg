-- Forward declarations resolved in later sections (assigned before any runtime call).
local cloudGetSalt   -- assigned in [SECTION 11]; fetches salt from backend
local cloudPutSalt   -- assigned in [SECTION 11]; fire-and-forget salt store

-- Module-level identity state; populated by buildIdentity() during startup wiring.
local identity = nil

-- safeCall: pcall wrapper that preserves ALL return values via table.pack; returns nil if fn is missing or errored (BUG-12).
local function safeCall(fn, ...)
    if type(fn) ~= "function" then
        return nil
    end
    local r = table.pack(pcall(fn, ...))
    if not r[1] then
        return nil
    end
    return table.unpack(r, 2, r.n)
end

-- getSharedEnv: shared env table; probes getAsterEnv() then getgenv() then a module-local table, each pcall'd (spec §10).
local fallbackSharedEnv = {}
local function getSharedEnv()
    local a = getAsterEnv
    if type(a) == "function" then
        local env = safeCall(a)
        if type(env) == "table" then
            return env
        end
    end
    local g = getgenv
    if type(g) == "function" then
        local env = safeCall(g)
        if type(env) == "table" then
            return env
        end
    end
    return fallbackSharedEnv
end

-- readTextFile: pcall'd isfile+readfile returning contents or nil; silently nil when file I/O is unavailable (BUG-13 policy).
local function readTextFile(path)
    local f = isfile
    if type(f) ~= "function" then
        return nil
    end
    local ok, exists = pcall(f, path)
    if not ok or not exists then
        return nil
    end
    local r = readfile
    if type(r) ~= "function" then
        return nil
    end
    local ok2, data = pcall(r, path)
    if not ok2 or type(data) ~= "string" then
        return nil
    end
    return data
end

-- writeTextFile: pcall'd writefile returning success boolean; never errors when file I/O is unavailable.
local function writeTextFile(path, data)
    local w = writefile
    if type(w) ~= "function" then
        return false
    end
    return pcall(w, path, data) == true
end

-- deleteTextFile: pcall'd delfile; no-op when unavailable.
local function deleteTextFile(path)
    local d = delfile
    if type(d) ~= "function" then
        return
    end
    pcall(d, path)
end

-- FIX: ensureFolder now falls back to segment-by-segment creation. Some
-- executors' makefolder does not create parent directories recursively;
-- calling makefolder("ASTER/identity") on those silently fails when
-- "ASTER" doesn't already exist, so every subsequent write goes to a
-- non-existent directory. The primary pcall handles recursive-capable
-- executors; the fallback handles the rest.

-- ensureFolder: pcall'd makefolder; invoked before EVERY write because the
-- folder may be wiped mid-session (test 14). Falls back to segment-by-segment
-- creation for executors whose makefolder does not create parents recursively.
local function ensureFolder(dir)
    local m = makefolder
    if type(m) ~= "function" then
        return
    end
    if pcall(m, dir) then
        return
    end
    -- Non-recursive makefolder: create each path segment in turn.
    local accumulated = ""
    for segment in dir:gmatch("[^/]+") do
        accumulated = (accumulated == "") and segment or (accumulated .. "/" .. segment)
        pcall(m, accumulated)
    end
end

-- randomHex: n lowercase hex chars sourced from HttpService:GenerateGUID entropy (always present); math.random only as last resort.
local function randomHex(n)
    local pool = ""
    local ok, g1 = pcall(function()
        return HttpService:GenerateGUID(false)
    end)
    if ok and type(g1) == "string" then
        pool = pool .. g1:gsub("-", ""):lower()
    end
    local ok2, g2 = pcall(function()
        return HttpService:GenerateGUID(false)
    end)
    if ok2 and type(g2) == "string" then
        pool = pool .. g2:gsub("-", ""):lower()
    end
    if #pool >= n then
        return pool:sub(1, n)
    end
    -- Defensive fallback: GenerateGUID should never fail, but never crash if it does.
    local out = {}
    for i = 1, n do
        out[i] = string.format("%x", math.random(0, 15))
    end
    return table.concat(out)
end

-- detectExecutor: probes identifyexecutor() then getexecutorname(); safeCall preserves the (name, version) pair (BUG-12, test 18).
local function detectExecutor()
    local name, version
    local fn = identifyexecutor
    if type(fn) == "function" then
        name, version = safeCall(fn)
    end
    if type(name) ~= "string" then
        version = nil
        local alt = getexecutorname
        if type(alt) == "function" then
            name = safeCall(alt)
        end
    end
    if type(name) ~= "string" or #name == 0 then
        name = "Unknown"
    end
    if type(version) ~= "string" then
        version = nil
    end
    return name, version
end

-- getRawHwid: probes gethwid / get_hwid via an explicit nil-checked candidate list; NO rawget(_G, ...), NO ipairs over nil-holed tables (BUG-3/BUG-4).
local function getRawHwid()
    local candidates = {}
    local a = gethwid
    if type(a) == "function" then
        candidates[#candidates + 1] = a
    end
    local b = get_hwid
    if type(b) == "function" then
        candidates[#candidates + 1] = b
    end
    for i = 1, #candidates do
        local fn = candidates[i]
        if type(fn) == "function" then
            local ok, v = pcall(fn)
            if ok and type(v) == "string" and #v > 0 then
                return v
            end
            if ok and type(v) == "number" then
                return tostring(v)
            end
        end
    end
    return nil
end

-- loadOrCreateFallbackDeviceId: returns a persisted random device id when no HWID source exists; generated once, reused forever (test 6).
local function loadOrCreateFallbackDeviceId()
    local existing = readTextFile(DEVICE_FALLBACK_PATH)
    if type(existing) == "string" then
        local trimmed = existing:match("^%s*(.-)%s*$")
        if #trimmed >= 16 then
            return trimmed
        end
    end
    local fresh = "fallback-" .. randomHex(32)
    ensureFolder(ASTER_IDENTITY_DIR)
    writeTextFile(DEVICE_FALLBACK_PATH, fresh)
    return fresh
end

-- saltPathFor: local salt blob location keyed by the FIRST 16 hex chars of lookupHash (BUG-1 layout); no environment assumptions.
local function saltPathFor(lookupHash)
    return ASTER_IDENTITY_DIR .. "/salt_" .. lookupHash:sub(1, 16) .. ".dat"
end

-- loadLocalSalt: reads and validates the locally stored salt for a lookupHash; returns lowercase hex or nil.
local function loadLocalSalt(lookupHash)
    local raw = readTextFile(saltPathFor(lookupHash))
    if type(raw) ~= "string" then
        return nil
    end
    local s = raw:match("^%s*(.-)%s*$")
    if #s == SALT_HEX_LEN and s:match("^[0-9a-fA-F]+$") then
        return s:lower()
    end
    return nil
end

-- storeLocalSalt: persists a salt blob locally; folder is (re)created first because it may have been wiped mid-session.
local function storeLocalSalt(lookupHash, salt)
    ensureFolder(ASTER_IDENTITY_DIR)
    writeTextFile(saltPathFor(lookupHash), salt)
end

-- asterResolveSalt: real salt store replacing the undefined asterFindExistingSalt (BUG-1): local file -> backend GET -> generate + fire-and-forget PUT.
local function asterResolveSalt(lookupHash)
    -- 1) Local cache hit.
    local localSalt = loadLocalSalt(lookupHash)
    if localSalt then
        return localSalt
    end
    -- 2) Backend lookup (new-device path; only when backend is configured).
    if type(cloudGetSalt) == "function" then
        local remote = cloudGetSalt(lookupHash)
        if type(remote) == "string" and #remote == SALT_HEX_LEN and remote:match("^[0-9a-fA-F]+$") then
            remote = remote:lower()
            storeLocalSalt(lookupHash, remote)
            return remote
        end
    end
    -- 3) Fresh 128-bit salt; stored locally and pushed to the backend fire-and-forget (never blocks startup).
    local fresh = randomHex(SALT_HEX_LEN)
    storeLocalSalt(lookupHash, fresh)
    if type(cloudPutSalt) == "function" then
        task.spawn(function()
            pcall(cloudPutSalt, lookupHash, fresh)
        end)
    end
    return fresh
end

-- buildIdentity: derives lookupHash -> salt -> userKey plus metadata-only deviceKey; performs no blocking network work.
-- VERIFY (test 8): userKey derives from UserId + salt ONLY; the username is never an input, so a rename keeps the same userKey.
local function buildIdentity(userId)
    userId = tonumber(userId) or 0
    local lookupHash = hash(NS_PUB .. tostring(userId))
    -- RESIDUAL ENUMERATION RISK (BUG-2, documented and accepted): the salt lookup key depends ONLY on UserId,
    -- so anyone who knows a victim's UserId AND extracts the "ASTER.pub.v4" namespace string from this script
    -- can compute lookupHash and retrieve that victim's salt. Acceptable for config sync; NOT for licensing.
    local userSalt = asterResolveSalt(lookupHash)
    local userKey = hash(NS_ACC .. tostring(userId) .. userSalt)
    local rawHwid = getRawHwid()
    local hwidIsFallback = false
    if not rawHwid then
        rawHwid = loadOrCreateFallbackDeviceId()
        hwidIsFallback = true
    end
    -- BUG-16: executor name is NOT inside deviceKey (it caused false new-device alerts); it lives only as identity metadata.
    local deviceKey = hash(NS_DEV .. tostring(userId) .. rawHwid)
    local execName, execVersion = detectExecutor()
    identity = {
        userId           = userId,
        lookupHash       = lookupHash,
        userSalt         = userSalt,
        userKey          = userKey,     -- cloud lookup key AND local file name
        deviceKey        = deviceKey,   -- METADATA ONLY, never a storage key
        hwidIsFallback   = hwidIsFallback,
        executor         = execName,    -- metadata only
        executorVersion  = execVersion, -- preserved from identifyexecutor() (test 18)
    }
    return identity
end

-- getIdentity: accessor for the derived identity table; nil until buildIdentity has run.
local function getIdentity()
    return identity
end

