    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}

-- SHA-256 initial state: first 32 bits of the fractional parts of the square roots of the first 8 primes.
local SHA256_H0 = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }

-- bytesToHex: encodes a byte string as lowercase hex; no environment assumptions.
local function bytesToHex(s)
    return (s:gsub(".", function(c)
        return string.format("%02x", string.byte(c))
    end))
end

-- wordToBEBytes: converts a 32-bit word (as a Lua number) into 4 big-endian bytes; no environment assumptions.
local function wordToBEBytes(w)
    local b1 = math.floor(w / 16777216) % 256
    local b2 = math.floor(w / 65536) % 256
    local b3 = math.floor(w / 256) % 256
    local b4 = w % 256
    return string.char(b1, b2, b3, b4)
end

-- sha256Pure: FIPS 180-4 SHA-256 over a byte string, returning 64-char lowercase hex; requires only bit32 + string/math.
local function sha256Pure(msg)
    local band, bxor, bnot = bit32.band, bit32.bxor, bit32.bnot
    local rshift, rrotate  = bit32.rshift, bit32.rrotate

    -- Pre-processing: append 0x80, pad with zeros to 56 mod 64, then append the 64-bit big-endian bit length.
    local bitLen = #msg * 8
    local padded = msg .. "\128"
    local padZeros = (56 - (#padded % 64)) % 64
    padded = padded .. string.rep("\0", padZeros)
    local lenHi = math.floor(bitLen / 4294967296)
    local lenLo = bitLen % 4294967296
    padded = padded .. wordToBEBytes(lenHi) .. wordToBEBytes(lenLo)

    local h0, h1, h2, h3 = SHA256_H0[1], SHA256_H0[2], SHA256_H0[3], SHA256_H0[4]
    local h4, h5, h6, h7 = SHA256_H0[5], SHA256_H0[6], SHA256_H0[7], SHA256_H0[8]
    local w = {}

    -- Process the message in successive 64-byte chunks.
    for chunk = 1, #padded, 64 do
        for i = 0, 15 do
            local o = chunk + i * 4
            local b1, b2, b3, b4 = string.byte(padded, o, o + 3)
            w[i + 1] = b1 * 16777216 + b2 * 65536 + b3 * 256 + b4
        end
        for i = 17, 64 do
            local x = w[i - 15]
            local s0 = bxor(rrotate(x, 7), rrotate(x, 18), rshift(x, 3))
            local y = w[i - 2]
            local s1 = bxor(rrotate(y, 17), rrotate(y, 19), rshift(y, 10))
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) % 4294967296
        end

        local a, b, c, d = h0, h1, h2, h3
        local e, f, g, hh = h4, h5, h6, h7

        -- Main compression loop (64 rounds).
        for i = 1, 64 do
            local S1 = bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
            local ch = bxor(band(e, f), band(bnot(e), g))
            local t1 = (hh + S1 + ch + SHA256_K[i] + w[i]) % 4294967296
            local S0 = bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
            local maj = bxor(band(a, b), band(a, c), band(b, c))
            local t2 = (S0 + maj) % 4294967296
            hh = g
            g = f
            f = e
            e = (d + t1) % 4294967296
            d = c
            c = b
            b = a
            a = (t1 + t2) % 4294967296
        end

        h0 = (h0 + a) % 4294967296
        h1 = (h1 + b) % 4294967296
        h2 = (h2 + c) % 4294967296
        h3 = (h3 + d) % 4294967296
        h4 = (h4 + e) % 4294967296
        h5 = (h5 + f) % 4294967296
        h6 = (h6 + g) % 4294967296
        h7 = (h7 + hh) % 4294967296
    end

    return string.format("%08x%08x%08x%08x%08x%08x%08x%08x", h0, h1, h2, h3, h4, h5, h6, h7)
end

--============================================================================--
-- [SECTION 3] Hash normalizer (executor crypt.hash -> fallback to [2])
--============================================================================--

-- FIX (BUG-5): base64DecodeBytes accumulator is now bounded. Each iteration
-- previously multiplied `acc` by 64 without ever discarding emitted bits, so
-- after ~9 base64 chars the accumulator exceeded 2^53 (double precision) and
-- every subsequent byte decoded to garbage. The appended modulo drops emitted
-- bits, keeping `acc` under 2^13 — exact in doubles for inputs of any length.

-- base64DecodeBytes: pure-Lua base64 decoder returning a raw byte string, or nil on malformed input; no environment assumptions.
local function base64DecodeBytes(b64)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, 64 do
        lookup[string.byte(alphabet, i)] = i - 1
    end
    b64 = b64:gsub("=", "")
    local out = {}
    local acc, bits = 0, 0
    for i = 1, #b64 do
        local v = lookup[string.byte(b64, i)]
        if v == nil then
            return nil
        end
        acc = acc * 64 + v
        bits = bits + 6
        if bits >= 8 then
            bits = bits - 8
            local byte = math.floor(acc / (2 ^ bits)) % 256
            out[#out + 1] = string.char(byte)
            acc = acc % (2 ^ bits)   -- drop emitted bits; without this, acc exceeds 2^53 and corrupts output
        end
    end
    return table.concat(out)
end

-- normalizeDigest: converts a crypt.hash digest (64-hex or base64) to canonical
-- 64-char lowercase hex; nil on unknown format (BUG-5).
local function normalizeDigest(out)
    if type(out) ~= "string" then
        return nil
    end
    -- Hex check first: a 64-char hex string also matches the base64 shape, so order matters.
    if #out == 64 and out:match("^[0-9a-fA-F]+$") then
        return out:lower()
    end
    -- Base64-shaped output: decode to bytes, then re-encode as lowercase hex;
    -- a SHA-256 digest must decode to exactly 32 bytes.
    if #out % 4 == 0 and out:match("^[A-Za-z0-9+/]+=*$") then
        local raw = base64DecodeBytes(out)
        if raw and #raw == 32 then
            return bytesToHex(raw)
        end
    end
    return nil
end

-- hash: module-wide SHA-256 entry point returning lowercase hex; executor variants
-- are probed with pcall, pure-Lua is the fallback (BUG-5). Every other section
-- must call hash() and never crypt.hash directly.
local function hash(input)
    input = tostring(input)
    -- Primary: executor-provided crypt.hash (read global directly, never via _G; BUG-3).
    local c = crypt
    if type(c) == "table" and type(c.hash) == "function" then
        local ok, out = pcall(c.hash, input, "sha256")
        if ok then
            local n = normalizeDigest(out)
            if n then
                return n
            end
        end
    end
    -- Secondary: syn.crypt.hash on Synapse-style environments.
    local s = syn
    if type(s) == "table" and type(s.crypt) == "table" and type(s.crypt.hash) == "function" then
        local ok, out = pcall(s.crypt.hash, input, "sha256")
        if ok then
            local n = normalizeDigest(out)
            if n then
                return n
            end
        end
    end
    -- Final fallback: pure-Lua SHA-256 from section 2.
    return sha256Pure(input)
end

--============================================================================--
-- [SECTION 4] Canonical JSON encoder (deterministic key order, proper escaping)
--============================================================================--

-- canonicalQuote: escapes a string per strict JSON rules (control bytes become \u00XX); no environment assumptions.
local function canonicalQuote(s)
    local parts = { "\"" }
    for i = 1, #s do
        local b = string.byte(s, i)
        if b == 34 then
            parts[#parts + 1] = "\\\""
        elseif b == 92 then
            parts[#parts + 1] = "\\\\"
        elseif b == 8 then
            parts[#parts + 1] = "\\b"
        elseif b == 9 then
            parts[#parts + 1] = "\\t"
        elseif b == 10 then
            parts[#parts + 1] = "\\n"
        elseif b == 12 then
            parts[#parts + 1] = "\\f"
        elseif b == 13 then
            parts[#parts + 1] = "\\r"
        elseif b < 32 then
            parts[#parts + 1] = string.format("\\u%04x", b)
        else
            parts[#parts + 1] = string.char(b)
        end
    end
    parts[#parts + 1] = "\""
    return table.concat(parts)
end

-- canonicalNumber: renders integers without ".0" and floats via %.17g; NaN/inf collapse to null; no environment assumptions.
local function canonicalNumber(n)
    if n ~= n or n == math.huge or n == -math.huge then
        return "null"
    end
    if n == 0 then
        return "0"   -- normalize negative zero
    end
    if n % 1 == 0 and math.abs(n) < 9007199254740992 then
        return string.format("%.0f", n)
    end
    return string.format("%.17g", n)
end

-- canonicalEncode: deterministic JSON serialization used for checksums and storage
-- envelopes (BUG-9); object keys are sorted by byte order, gapless integer-keyed
-- tables encode as arrays; no environment assumptions.
local function canonicalEncode(value)
    local t = type(value)
    if t == "nil" then
        return "null"
    elseif t == "boolean" then
        return value and "true" or "false"
    elseif t == "number" then
        return canonicalNumber(value)
    elseif t == "string" then
        return canonicalQuote(value)
    elseif t ~= "table" then
        return "null"   -- unsupported types (functions, userdata) serialize as null
    end

    -- Collect keys and decide array vs object shape.
    local keys = {}
    local count = 0
    for k in pairs(value) do
        count = count + 1
        keys[count] = k
    end
    if count == 0 then
        return "{}"   -- empty table encodes as an object
    end

    local isArray = true
    local maxIndex = 0
    for i = 1, count do
        local k = keys[i]
        if type(k) ~= "number" or k % 1 ~= 0 or k < 1 then
            isArray = false
            break
        end
        if k > maxIndex then
            maxIndex = k
        end
    end
    if maxIndex ~= count then
        isArray = false   -- any gap in 1..n forces object form
    end

    local parts = {}
    if isArray then
        for i = 1, count do
            parts[i] = canonicalEncode(value[i])
        end
        return "[" .. table.concat(parts, ",") .. "]"
    end

    -- Deterministic object form: sort keys bytewise via tostring comparison.
    table.sort(keys, function(a, b)
        return tostring(a) < tostring(b)
    end)
    for i = 1, count do
        local k = keys[i]
        parts[i] = canonicalQuote(tostring(k)) .. ":" .. canonicalEncode(value[k])
    end
    return "{" .. table.concat(parts, ",") .. "}"
end

