ASTER_SELFTEST = false  -- flip to true to run on next execution

if ASTER_SELFTEST then
    task.spawn(function()
        local function check(name, cond)
            print(("[ASTER v4 SELFTEST] %s: %s"):format(name, cond and "PASS" or "FAIL"))
        end

        -- 1. SHA-256 known vector
        check("sha256_abc",
            hash("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

        -- 2. Canonical encode stability
        local a = canonicalEncode({ b = 2, a = 1 })
        local b = canonicalEncode({ a = 1, b = 2 })
        check("canonical_stable", a == b)

        -- 3. Round-trip save/load on a scratch key (cleaned up afterwards)
        local testKey  = "selftest_" .. randomHex(8)
        local snapshot = {
            version = CONFIG_VERSION,
            values  = { st = { v = "roundtrip", t = 123 } },
            deviceHistory = {},
        }
        local savedOk = saveConfigBlob(testKey, snapshot)
        local loaded  = loadConfigBlob(testKey)
        check("save_load_roundtrip",
            savedOk == true and type(loaded) == "table"
            and loaded.values.st.v == "roundtrip"
            and loaded.values.st.t == 123)

        -- 4. Corruption recovery: corrupt .dat + valid .bak loads .bak (test 2)
        local datPath, bakPath = cfgPaths(testKey)
        writeTextFile(bakPath, encodeEnvelope(snapshot))
        writeTextFile(datPath, "AXC:corrupted-not-base64!!")
        local recovered = loadConfigBlob(testKey)
        check("corruption_recovery",
            type(recovered) == "table" and recovered.values.st.v == "roundtrip")
        deleteTextFile(datPath)
        deleteTextFile(bakPath)

        -- 5. Merge per-key LWW: higher t wins; stored boolean false survives
        local merged = mergeConfigs(
            { values = { k = { v = "old", t = 1 }, f = { v = true,  t = 1 } } },
            { values = { k = { v = "new", t = 2 }, f = { v = false, t = 2 } } })
        check("merge_lww",
            merged.values.k.v == "new"
            and merged.values.f.v == false
            and type(merged.values.f.v) == "boolean")

        -- 6. Rate limiter: drained bucket denies until refill
        while bucketTake() do end
        check("rate_limiter", bucketTake() == false)
    end)
end

