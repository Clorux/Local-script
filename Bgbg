-- Cloud gate for the UserId==0 case (test 15): asterBoot sets this BEFORE
-- buildIdentity; 0 suppresses ALL cloud calls, including the salt bootstrap
-- inside asterResolveSalt (which runs during identity derivation).
local bootSyncUserId = nil

-- cloudGetSalt: GET /salt/<lookupHash> per the backend contract (§2.4);
-- returns the salt string or nil on any failure. Assigned to the forward
-- declaration from [SECTION 6]; only ever called from task.spawn'd contexts.
cloudGetSalt = function(lookupHash)
    if bootSyncUserId == 0 then
        return nil   -- UserId never resolved: no network at all (test 15)
    end
    if not backendConfigured() or not httpEnabled() then
        return nil
    end
    local status, body = httpJson("GET", BACKEND_URL .. "/salt/" .. tostring(lookupHash))
    if status == 200 and type(body) == "table" and type(body.salt) == "string" then
        return body.salt
    end
    return nil
end

-- cloudPutSalt: PUT /salt/<lookupHash> per the backend contract (§2.4);
-- fire-and-forget at the call site, but this function itself is blocking
-- (it wraps httpJson). Callers that need non-blocking behavior should
-- task.spawn it. Failures are silent.
cloudPutSalt = function(lookupHash, salt)
    if bootSyncUserId == 0 then
        return   -- UserId never resolved: no network at all (test 15)
    end
    if not backendConfigured() or not httpEnabled() then
        return
    end
    httpJson("PUT", BACKEND_URL .. "/salt/" .. tostring(lookupHash), { salt = salt })
end

-- cloudPull: GET /pull?k=<userKey> per the backend contract; the query
-- carries ONLY the key (uid removed, BUG-8). Returns dataTable or nil.
-- Only called from task.spawn'd async contexts (asterBoot's thread).
local function cloudPull(userKey)
    if not backendConfigured() or not httpEnabled() then
        return nil
    end
    local status, body = httpJson("GET", BACKEND_URL .. "/pull?k=" .. tostring(userKey))
    if status == 200 and type(body) == "table" and type(body.data) == "table" then
        return body.data, tonumber(body.updatedAt)
    end
    return nil
end

-- cloudPush: POST /push {k, data, device} per the backend contract; spawns
-- its own worker so the caller never blocks.
local function cloudPush(userKey, data, deviceKey)
    if not backendConfigured() or not httpEnabled() then
        return
    end
    task.spawn(function()
        httpJson("POST", BACKEND_URL .. "/push", {
            k      = userKey,
            data   = data,
            device = deviceKey,   -- metadata only, never a storage key (§2.1)
        })
    end)
end

-- Debounce state for the 2-second-inactivity save (BUG-14); tick() is
-- monotonic, so wall-clock changes cannot break it.
local savePending  = false
local saveDeadline = 0

-- markDirty: (re)arms the 2-second-inactivity debounce; assigned to the
-- forward declaration from [SECTION 9].
markDirty = function()
    savePending  = true
    saveDeadline = tick() + SAVE_DEBOUNCE_SECONDS
end

-- flushSaveIfDue: heartbeat callback — once the debounce deadline passes,
-- save locally then async push (spec §2.3).
local function flushSaveIfDue()
    if not savePending or tick() < saveDeadline then
        return
    end
    savePending = false
    if type(liveConfig) ~= "table" or type(identity) ~= "table" then
        return
    end
    saveConfigBlob(identity.userKey, liveConfig)
    if identity.userId ~= 0 then
        cloudPush(identity.userKey, liveConfig, identity.deviceKey)
    end
end

-- noteDeviceBoot: refreshes lastDevice and deviceHistory; entries are
-- deduped by deviceKey with seenAt updated in place (BUG-15, test 19).
-- Returns true when lastDevice.deviceKey differs from the current deviceKey
-- — the spec §2.3 new-device condition. Mutates cfg in place.
local function noteDeviceBoot(cfg, id)
    cfg.deviceHistory = type(cfg.deviceHistory) == "table" and cfg.deviceHistory or {}
    local now = os.time()
    local isNewDevice = (type(cfg.lastDevice) ~= "table")
        or (cfg.lastDevice.deviceKey ~= id.deviceKey)
    local found = false
    for _, e in pairs(cfg.deviceHistory) do
        if type(e) == "table" and e.deviceKey == id.deviceKey then
            e.seenAt   = now           -- existing entry: refresh seenAt, do NOT append
            e.executor = id.executor
            found = true
        end
    end
    if not found then
        cfg.deviceHistory[#cfg.deviceHistory + 1] =
            { deviceKey = id.deviceKey, executor = id.executor, seenAt = now }
    end
    cfg.lastDevice = { deviceKey = id.deviceKey, executor = id.executor, seenAt = now }
    return isNewDevice
end

-- cloudBootSync: async boot sync per spec §2.3 — pull, per-key LWW merge
-- into liveConfig, save local. Silently skipped when the backend is a
-- placeholder/nil or HTTP is unavailable (tests 4, 5, 10). Runs only inside
-- the boot thread.
--
-- FIX: the salt heal PUT is now fire-and-forget. Previously it blocked for
-- up to one HTTP timeout (10s), which stacked on top of the pull's timeout
-- to stall asterBoot for 20s on a slow/flaky connection. The PUT is
-- idempotent and its result is not needed for the pull that follows.
local function cloudBootSync()
    if not backendConfigured() or not httpEnabled() then
        return
    end
    if type(identity) ~= "table" or type(liveConfig) ~= "table" then
        return
    end
    -- Idempotent salt upsert (heals a PUT that silently failed earlier).
    task.spawn(function()
        pcall(cloudPutSalt, identity.lookupHash, identity.userSalt)
    end)
    -- Pull is synchronous so the merge lands before asterBoot returns.
    local remote = cloudPull(identity.userKey)
    if type(remote) == "table" then
        mergeConfigs(liveConfig, remote)
        saveConfigBlob(identity.userKey, liveConfig)
    end
end

--============================================================================--
-- [SECTION 12] Discord notify (hash-prefix-only)
--============================================================================--

-- discordEnabled: notifications are no-ops unless DISCORD_HOOK is set AND
-- an HTTP function exists (spec §2.5).
local function discordEnabled()
    return type(DISCORD_HOOK) == "string" and #DISCORD_HOOK > 0 and httpEnabled()
end

-- notifyDiscord: one-way notification carrying truncated hash tags ONLY
-- (spec §2.5). NEVER sends raw UserId, raw HWID, or config contents; the
-- username is included ONLY when opts.includeUsername == true (BUG-18).
-- Rate limited by the [SECTION 10] token bucket (2 burst, refill 1/30s);
-- on HTTP 429 reads Retry-After, backs off, retries once (test 13).
local function notifyDiscord(event, fields, opts)
    if not discordEnabled() or type(identity) ~= "table" then
        return
    end
    if tick() < discordBackoffUntil then
        return   -- inside a 429 backoff window: drop silently
    end
    if not bucketTake() then
        return   -- rate limited: drop silently (do NOT set backoff; caller unaware is OK)
    end
    opts = type(opts) == "table" and opts or {}
    local id = identity
    local lines = {
        "[ASTER v4] " .. tostring(event),
        "userTag: "   .. id.userKey:sub(1, 12),    -- first 12 hex of userKey ONLY
        "deviceTag: " .. id.deviceKey:sub(1, 12),  -- first 12 hex of deviceKey ONLY
        "executor: "  .. tostring(id.executor),
    }
    if type(fields) == "table" then
        for k, v in pairs(fields) do
            local tv = type(v)
            if tv == "string" or tv == "number" or tv == "boolean" then
                lines[#lines + 1] = tostring(k) .. ": " .. tostring(v)
            end
        end
    end
    if opts.includeUsername == true then
        local lp = Players.LocalPlayer
        if lp then
            lines[#lines + 1] = "username: " .. tostring(lp.Name)
        end
    end
    local payload = { content = table.concat(lines, "\n") }
    task.spawn(function()
        local status, _, resp = httpJson("POST", DISCORD_HOOK, payload)
        if status == 429 then
            local retryAfter = math.min(readRetryAfter(resp) or 5, 120)
            discordBackoffUntil = tick() + retryAfter
            task.wait(retryAfter)   -- back off per Retry-After, then retry exactly once
            local status2, _, resp2 = httpJson("POST", DISCORD_HOOK, payload)
            if status2 == 429 then
                local again = math.min(readRetryAfter(resp2) or 5, 120)
                discordBackoffUntil = tick() + again   -- still limited: extend, give up
            end
        end
    end)
end

--============================================================================--
-- [SECTION 13] Public API
--============================================================================--

-- Host integration references supplied via asterInit; default to internal
-- stubs (spec §10). Never required to be non-nil.
local hostSettings   = {}
local hostUIRegistry = nil

-- ASTER_API: the public surface; published into the shared env as
-- __ASTER_IDENTITY_V4 by [SECTION 14].
local ASTER_API = {}

-- asterInit: accepts premium.txt's settings table and UI registry (or nil);
-- works standalone with internal stubs (spec §10).
function ASTER_API.asterInit(settingsTable, uiRegistryOrNil)
    hostSettings   = type(settingsTable) == "table" and settingsTable or {}
    hostUIRegistry = type(uiRegistryOrNil) == "table" and uiRegistryOrNil or nil
    return ASTER_API
end

-- ASTER_API.get: tolerant unwrapped config read; returns default when the
-- key is absent or config not yet loaded.
function ASTER_API.get(key, default)
    return asterConfigGet(key, default)
end

-- ASTER_API.set: validated JSON-safe write wrapped as {v, t=os.time()};
-- the 2s debounce then saves locally and pushes async (BUG-11/BUG-14).
function ASTER_API.set(key, value)
    return asterConfigSet(key, value)
end

-- ASTER_API.saveNow: immediate local save + async push, bypassing the
-- debounce; returns local-save success.
function ASTER_API.saveNow()
    if type(liveConfig) ~= "table" or type(identity) ~= "table" then
        return false
    end
    local ok = saveConfigBlob(identity.userKey, liveConfig)
    if identity.userId ~= 0 then
        cloudPush(identity.userKey, liveConfig, identity.deviceKey)
    end
    return ok == true
end

-- ASTER_API.identity: returns identity metadata (hash tags, executor info);
-- NEVER includes the raw HWID or config contents.
function ASTER_API.identity()
    local id = identity
    if type(id) ~= "table" then
        return nil
    end
    return {
        userId          = id.userId,
        userKey         = id.userKey,
        deviceKey       = id.deviceKey,
        lookupHash      = id.lookupHash,
        userTag         = id.userKey:sub(1, 12),
        deviceTag       = id.deviceKey:sub(1, 12),
        executor        = id.executor,
        executorVersion = id.executorVersion,
        hwidIsFallback  = id.hwidIsFallback,
    }
end

-- ASTER_API.notify: fires a one-way hash-prefix-only Discord notification;
-- no-op when DISCORD_HOOK is nil (spec §2.5).
function ASTER_API.notify(event, fields, opts)
    notifyDiscord(event, fields, opts)
end

-- publishApi: publishes the API into the shared env — getAsterEnv() first,
-- getgenv() fallback, module-local last resort (spec §10). Attaches to
-- premium.txt's __ASTER_RUNTIME only if it already exists (probed, never
-- assumed).
local function publishApi()
    local env = getSharedEnv()
    env.__ASTER_IDENTITY_V4 = ASTER_API
    if type(env.__ASTER_RUNTIME) == "table" then
        env.__ASTER_RUNTIME.identityConfigV4 = ASTER_API
    end
end

--============================================================================--
-- [SECTION 14] Startup wiring
--============================================================================--

-- startHeartbeat: drives the save debounce via premium.txt's
-- registerHeartbeatUpdate when present, else RunService.Heartbeat directly
-- (spec §10).
local function startHeartbeat()
    local r = registerHeartbeatUpdate
    if type(r) == "function" then
        local ok = pcall(r, "ASTER_IDENTITY_CFG_V4", flushSaveIfDue)
        if ok then
            return
        end
    end
    pcall(function()
        game:GetService("RunService").Heartbeat:Connect(flushSaveIfDue)
    end)
end

-- asterBoot: full startup sequence; runs inside task.spawn so salt/config
-- network work NEVER blocks the caller (spec §2.3).
--
-- FIX (two related issues):
--   1. legacyImportOnce writes a GLOBAL marker file (ASTER/identity/.legacy_imported).
--      Previously it ran unconditionally. If LocalPlayer failed to resolve
--      (userId == 0), the marker was written against a placeholder session,
--      permanently poisoning the one-shot import for every future real session.
--      Now gated under syncAllowed.
--   2. saveConfigBlob / notifyDiscord / cloudBootSync all have persistent or
--      network side effects and were only partially gated. Consolidated under
--      a single syncAllowed block so userId == 0 stays fully offline and
--      in-memory (test 15).
local function asterBoot()
    -- Test 15: UserId == 0 (LocalPlayer timing) — wait up to
    -- USERID_WAIT_SECONDS, then continue local-only and skip ALL side effects.
    local lp = Players.LocalPlayer
    local userId = (lp and lp.UserId) or 0
    local waitStart = tick()
    while userId == 0 and (tick() - waitStart) < USERID_WAIT_SECONDS do
        task.wait(0.1)
        lp = Players.LocalPlayer
        userId = (lp and lp.UserId) or 0
    end
    bootSyncUserId = userId   -- [SECTION 11] gate: when still 0, stay offline
    local syncAllowed = (userId ~= 0)

    local id = buildIdentity(userId)   -- may GET /salt on a new device; safe here
    -- Load local config (corruption recovery and backup promotion live in
    -- loadConfigBlob, tests 2, 3); fresh installs get defaults (test 1).
    local cfg = loadConfigBlob(id.userKey)
    if type(cfg) ~= "table" then
        cfg = { version = CONFIG_VERSION, values = {}, deviceHistory = {}, createdAt = os.time() }
    end
    cfg = migrateConfig(cfg)       -- v1 -> v4 chain, warns if incomplete (BUG-20, test 16)

    -- Legacy import has a permanent global marker side effect; only run it
    -- on a real (non-placeholder) session.
    if syncAllowed then
        cfg = legacyImportOnce(cfg)
    end

    cfg.values         = type(cfg.values) == "table" and cfg.values or {}
    cfg.deviceHistory  = type(cfg.deviceHistory) == "table" and cfg.deviceHistory or {}
    liveConfig = cfg

    -- Device tracking runs unconditionally (in-memory only when userId == 0;
    -- the save below is what persists it).
    local isNewDevice = noteDeviceBoot(cfg, id)

    if syncAllowed then
        saveConfigBlob(id.userKey, cfg)
        if isNewDevice then
            -- Truncated hash tags only; no-op when DISCORD_HOOK is nil (test 9).
            notifyDiscord("new_device", {
                deviceCount  = #cfg.deviceHistory,
                hwidFallback = id.hwidIsFallback,
            })
        end
        cloudBootSync()   -- async pull -> merge -> save local; skipped if unconfigured
    end
    -- Without a backend, a new device simply cannot see configs from other
    -- devices: documented limitation (test 10).
end

-- Wire-up: publish the API, start the debounce heartbeat, then boot
-- asynchronously — startup never blocks on network.
publishApi()
startHeartbeat()
task.spawn(asterBoot)

